# Dependencias
node_modules/
.pnp/
.pnp.js

# Build
dist/
site/dist/
site/.astro/
site/node_modules/
build/
.cache/
.parcel-cache/
site/.wrangler/

# Entorno
.env
.env.local
.env.*.local
# Secretos locales de Cloudflare Pages Functions (ADR-0006). NUNCA se versiona:
# son las mismas llaves reales que van en Cloudflare, sólo que para el equipo local.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Capturas HTTrack: se versiona la captura integra (imagenes incluidas).
# Se excluyen los artefactos internos de HTTrack: hts-cache es duplicacion pura
# del contenido ya descargado, y "^" es el marcador de enlaces fuera de filtro.
investigacion/mirrors/**/hts-cache/
investigacion/mirrors/**/^/

# Logs
*.log
npm-debug.log*

# hts-log.txt NO se ignora: es la evidencia de que la captura termino completa
!investigacion/mirrors/**/hts-log.txt
