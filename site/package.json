{
  "name": "azucar-hotel-tulum",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-datos.mjs && astro build",
    "build:prod": "node scripts/check-datos.mjs --estricto && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "datos": "node scripts/check-datos.mjs",
    "test": "node --test \"src/**/*.test.mjs\"",
    "verificar": "bash ../scripts/verificar-todo.sh",
    "functions:dev": "wrangler pages dev dist --compatibility-date=2026-08-20"
  },
  "dependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
