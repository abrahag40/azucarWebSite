---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SeccionAlojamiento from '../components/SeccionAlojamiento.astro';
const idioma = 'es' as const;
---
<Base
  idioma={idioma}
  sobreHero
  titulo="Hotel Boutique Frente al Mar en Tulum | Azúcar Hotel Tulum"
  descripcion="Hotel boutique frente al Caribe en la Zona Hotelera de Tulum. Suites con jacuzzi privado, alberca infinita y playa. Solicita tu reserva directamente con nosotros."
>
  <Hero idioma={idioma} />
  <SeccionAlojamiento idioma={idioma} limite={3} />
</Base>
