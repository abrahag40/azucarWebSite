---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SeccionPresentacion from '../../components/SeccionPresentacion.astro';
import SeccionAlojamiento from '../../components/SeccionAlojamiento.astro';
import FranjaImagen from '../../components/FranjaImagen.astro';
import SeccionAmenidades from '../../components/SeccionAmenidades.astro';
const idioma = 'en' as const;
---
<Base
  idioma={idioma}
  sobreHero
  titulo="Beachfront Boutique Hotel in Tulum | Azúcar Hotel Tulum"
  descripcion="Boutique hotel on the Caribbean in Tulum's Hotel Zone. Suites with private jacuzzi, infinity pool and beach. Request your reservation directly with us."
>
  <Hero idioma={idioma} />
  <SeccionPresentacion idioma={idioma} />
  <SeccionAlojamiento idioma={idioma} limite={3} />
  <FranjaImagen idioma={idioma} />
  <SeccionAmenidades idioma={idioma} />
</Base>
