---
/**
 * Página de error 404 en inglés.
 *
 * Existe además de la raíz porque Cloudflare Pages resuelve el 404 buscando en
 * el directorio pedido y subiendo: sin este archivo, `/en/loquesea` caería en el
 * 404 en español. Ver `src/pages/404.astro` para el resto del razonamiento.
 */
import Base from '../../layouts/Base.astro';
import Error404 from '../../components/Error404.astro';
import { usarT } from '../../i18n/ui';
const idioma = 'en' as const;
const t = usarT(idioma);
---
<Base
  idioma={idioma}
  indexable={false}
  titulo={`${t('error404.titulo')} | Azúcar Hotel Tulum`}
  descripcion={t('error404.meta')}
>
  <Error404 idioma={idioma} />
</Base>
