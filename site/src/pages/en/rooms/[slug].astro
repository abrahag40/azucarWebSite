---
/**
 * Ficha de detalle, una por tipo publicado. Las rutas se generan desde los
 * datos: añadir un tipo al directorio de contenido crea su página sin tocar
 * ninguna plantilla, que es el criterio de aceptación de H2.1.
 *
 * `anterior` y `siguiente` salen del mismo orden que el listado, para que el
 * huésped pueda recorrer el catálogo sin volver atrás (criterio de H2.2).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BannerPagina from '../../../components/BannerPagina.astro';
import FichaAlojamiento from '../../../components/FichaAlojamiento.astro';
import Galeria from '../../../components/Galeria.astro';
import VecinasAlojamiento from '../../../components/VecinasAlojamiento.astro';
import { usarT } from '../../../i18n/ui';

const IDIOMA = 'en' as const;

export async function getStaticPaths() {
  const todos = (await getCollection('alojamiento', ({ data }) => data.publicado))
    .sort((a, b) => a.data.orden - b.data.orden);
  return todos.map((entrada, i) => ({
    params: { slug: entrada.id },
    props: { entrada, anterior: todos[i - 1], siguiente: todos[i + 1] },
  }));
}

interface Props {
  entrada: CollectionEntry<'alojamiento'>;
  anterior?: CollectionEntry<'alojamiento'>;
  siguiente?: CollectionEntry<'alojamiento'>;
}
const { entrada, anterior, siguiente } = Astro.props;
const { data } = entrada;

/**
 * El <title> se arma con el NOMBRE BASE, no con el nombre completo.
 *
 * Los nombres crecieron: «Habitación Deluxe Doble Queen · Vista parcial jardín
 * y/o mar» son 60 caracteres, y con « | Azucar Hotel Tulum» detrás son 81. El
 * límite práctico son 70 —`html-validate` lo comprueba— y Google recorta
 * alrededor de 60, así que un título así se ve truncado de todos modos.
 *
 * Se parte el nombre por el separador « · » y se queda la primera mitad —el
 * producto: «Habitación Deluxe Doble Queen», «Bungalow Mar»—, a la que se le
 * añade `vistaCorta`. El nombre LARGO no se pierde: es el que se ve en la
 * página, en el menú y en el listado. Es el título el que tiene un presupuesto
 * de caracteres, no el producto.
 *
 * Y `vistaCorta` sigue siendo imprescindible por lo de siempre: sin ella,
 * «Habitación Deluxe King · Vistas a la selva» y su versión inglesa tendrían el
 * mismo título que sus hermanas de vista al mar, y dos páginas con el mismo
 * <title> compiten entre sí en el buscador.
 */
const base = data.nombre[IDIOMA].split(' · ')[0];
const tituloSeo = data.vistaCorta
  ? `${base} · ${data.vistaCorta[IDIOMA]} | Azucar Hotel Tulum`
  : `${data.nombre[IDIOMA]} | Azucar Hotel Tulum`;
const t = usarT(IDIOMA);

// schema.org/HotelRoom enlazado al Hotel (historia H2.4). No se declara precio
// ni disponibilidad: no tenemos el dato confirmado y schema.org inventado es
// peor que schema.org ausente.
const schemaHabitacion = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: data.nombre[IDIOMA],
  description: data.descripcion[IDIOMA],
  bed: { '@type': 'BedDetails', typeOfBed: data.camas[IDIOMA] },
  occupancy: { '@type': 'QuantitativeValue', maxValue: data.capacidadMaxima },
  containedInPlace: { '@type': 'Hotel', name: 'Azucar Hotel Tulum' },
};
---
<Base
  idioma={IDIOMA}
  rutaActual={`alojamiento/${entrada.id}`}
  titulo={tituloSeo}
  imagenSocial={data.imagenPrincipal}
  descripcion={data.descripcion[IDIOMA]}
>
  <BannerPagina
    imagen={data.imagenPrincipal!}
    antetitulo={data.categoria === 'suite' ? t('alojamiento.suites') : t('alojamiento.habitaciones')}
    titulo={data.nombre[IDIOMA]}
  />
  {/* 🔴 LAS FOTOS VAN PRIMERO — cliente, 2026-09-01.
      Antes la ficha (descripción, datos, amenidades) iba delante de la galería.
      El orden nuevo es el que ya usa cualquier OTA y el que pide la evidencia:
      quien abre la ficha de una habitación decide primero con los ojos y sólo
      después lee. Poner la descripción delante obliga a un scroll de peaje
      antes de la información que de verdad se vino a buscar.

      Nota de accesibilidad: el orden VISUAL y el orden del MARCADO siguen
      coincidiendo —se movió el componente, no se reordenó con `order`—, así que
      el recorrido del teclado y el del lector de pantalla ven lo mismo que el
      ojo (WCAG 1.3.2 y 2.4.3). */}
  <Galeria imagenes={data.galeria} nombre={data.nombre[IDIOMA]} idioma={IDIOMA} />
  <FichaAlojamiento entrada={entrada} idioma={IDIOMA} />
  {/* Después de las fotos, no antes: la salida hacia otra habitación va al
      final del recorrido, cuando ya se enseñó todo lo de ésta. */}
  <VecinasAlojamiento anterior={anterior} siguiente={siguiente} idioma={IDIOMA} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaHabitacion)} />
</Base>
