---
import Base from '../../layouts/Base.astro';
import BannerPagina from '../../components/BannerPagina.astro';
import SeccionAmenidades from '../../components/SeccionAmenidades.astro';
import { usarT } from '../../i18n/ui';
import banner from '../../assets/hero-roof-top.webp';
const idioma = 'es' as const;
const t = usarT(idioma);
---
<Base
  idioma={idioma}
  rutaActual="servicios"
  titulo={`${t('servicios.titulo')} | Azúcar Hotel Tulum`}
  descripcion={t('servicios.meta')}
>
  <BannerPagina imagen={banner} titulo={t('servicios.titulo')} />
  <SeccionAmenidades idioma={idioma} />
</Base>
