---
/**
 * Iconos como SVG propio, dibujados a mano con trazo uniforme.
 *
 * Cappa usa tres familias de iconos —Flaticon, Themify y Font Awesome Pro—, que
 * suman 8.1 MB de tipografías y son recursos LICENCIADOS: siguen bloqueados por
 * el riesgo R-01. En vez de esperar a esa decisión o de añadir una dependencia,
 * se dibujan los seis que hacen falta.
 *
 * Van marcados `aria-hidden`: el significado lo lleva el encabezado de al lado,
 * y un lector de pantalla que anuncie "imagen" antes de cada título sólo añade
 * ruido (WCAG 1.1.1, icono decorativo acompañado de texto).
 */
interface Props { nombre: string; tam?: number }
const { nombre, tam = 34 } = Astro.props;

const trazos: Record<string, string> = {
  /* Persona: silueta de cabeza y hombros, para el aforo de las fichas.
     Es un pictograma de conteo, no un adorno: se repite una vez por huésped
     hasta el máximo del tipo. Ver `Aforo.astro`. */
  persona: 'M12 11a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8ZM5 20.5c0-3.6 3.1-6 7-6s7 2.4 7 6',
  // Olas del mar
  ola: 'M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 9c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2',
  // Alberca: superficie de agua con escalera
  alberca: 'M2 18c2.2 0 2.2-1.6 4.4-1.6S8.6 18 10.8 18s2.2-1.6 4.4-1.6S17.4 18 19.6 18M7 14V5a2 2 0 0 1 4 0M14 14V5a2 2 0 0 1 4 0M7 8h4m3 0h4',
  // Jacuzzi: tina con burbujas
  jacuzzi: 'M3 11h18v3a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-3ZM6 11V6a2 2 0 0 1 4 0M9 3.5v.01M13 5v.01M16 3v.01',
  // Restaurante: cubiertos
  restaurante: 'M6 3v8a2 2 0 0 0 4 0V3M8 11v10M16 3c-1.5 1-2 2.5-2 4.5S15 11 16 11v10',
  // Spa: flor de loto
  spa: 'M12 20c-4 0-7-2.5-7-6 0 0 2.5.4 4 1.8M12 20c4 0 7-2.5 7-6 0 0-2.5.4-4 1.8M12 20c0-5 1.6-8 4-10-3 .3-4 2-4 2s-1-1.7-4-2c2.4 2 4 5 4 10Z',
  // Wi-Fi: ondas y punto
  wifi: 'M5 12.5a10 10 0 0 1 14 0M8.5 15.8a5.5 5.5 0 0 1 7 0M12 19h.01',
  // Taza: cortesía de la mañana
  cafe: 'M4 8h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8ZM16 9h1.5a2.5 2.5 0 0 1 0 5H16M7 5V3.5M11 5V3.5',
  // Reloj: atención 24 h
  reloj: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2',
    // Teléfono: auricular — bloque de contacto
    telefono: 'M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3h1Z',
    // Sobre: correo
    correo: 'M3 6h18v12H3zM3 6.5l9 6.5 9-6.5',
    // Alfiler de mapa: dirección
    mapa: 'M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
    /* Mundo: selector de idioma. Es el mismo glifo que usa Cappa —`ti-world`,
       de Themify— en su propio selector de idioma del pie de página (línea 764
       de `index11.html`). No hay ninguna bandera en toda la plantilla: Cappa
       resuelve el cambio de idioma con este globo y un <select> de texto, nunca
       con iconografía de país. */
    mundo: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3 12h18M12 3c-3 3-3 15 0 18M12 3c3 3 3 15 0 18',
};
const d = trazos[nombre];
---
{d && (
  <svg
    class="icono"
    viewBox="0 0 24 24"
    width={tam}
    height={tam}
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d={d} />
  </svg>
)}
