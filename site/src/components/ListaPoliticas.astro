---
/**
 * Políticas agrupadas por tema.
 *
 * El original del hotel es una lista plana de dieciséis frases. Agrupadas por
 * tema —pago, identificación, horarios, cambios, convivencia— el huésped
 * encuentra lo que busca; en una lista plana tiene que leerlo todo. Es el único
 * cambio: no se altera ninguna condición.
 */
import { politicas } from '../data/politicas';
import type { Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---
<div class="politicas">
  {politicas.map((g) => (
    <section class="politicas__grupo">
      <h2 class="politicas__titulo">{g.titulo[idioma]}</h2>
      <ul class="politicas__lista" role="list">
        {g.puntos.map((p) => <li>{p[idioma]}</li>)}
      </ul>
    </section>
  ))}
</div>

<style>
  .politicas { display: grid; gap: var(--space-7); max-width: 46rem; }
  .politicas__titulo {
    font-size: var(--text-xl);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .politicas__lista { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .politicas__lista li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
  }
  .politicas__lista li::before {
    content: '';
    position: absolute; left: 0; top: 0.62em;
    width: 6px; height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }
</style>
