---
/**
 * Bloque práctico de la ficha de alojamiento — patrón `rooms-page` de
 * `room-details.html` de Cappa.
 *
 * ── QUÉ HACE LA PLANTILLA Y POR QUÉ TIENE RAZÓN ─────────────────────────────
 * Su ficha de habitación no se queda en la descripción y las amenidades: lleva
 * también **Check-in, Check-out, Pets y Children and extra beds**. Es decir, las
 * condiciones que deciden la compra, en la página donde se decide.
 *
 * Nuestra ficha no las tenía: el huésped que se preguntaba «¿a qué hora puedo
 * llegar?» o «¿puedo traer al perro?» tenía que salir a `/politicas/` o a las
 * preguntas frecuentes, y quien sale de una ficha de producto no siempre vuelve.
 *
 * ── DE DÓNDE SALE EL TEXTO ──────────────────────────────────────────────────
 * De `data/politicas.ts` y `data/faq.ts`, que son literales del sitio vigente.
 * **Ni una palabra nueva.** Se citan por CLAVE y no por posición: reordenar los
 * grupos de políticas es algo que va a pasar, y con un índice esta ficha
 * empezaría a mostrar la política de estacionamiento sin que nada fallara.
 */
import { politicas } from '../data/politicas';
import { faq } from '../data/faq';
import { usarT, ruta, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);

const horarios = politicas.find((g) => g.clave === 'horarios');
const porClave = (c: string) => faq.find((f) => f.clave === c);
const mascotas = porClave('mascotas');

/**
 * Sólo dos filas, y las dos por un motivo.
 *
 * ── «Entrada y salida»: el PRIMER punto, no el grupo entero ─────────────────
 * El grupo de políticas tiene cuatro puntos, y tres son cargos por salida
 * tardía. En una ficha de habitación eso es letra pequeña que aleja de la
 * decisión; lo que el huésped necesita aquí es la hora. El resto sigue completo
 * en `/politicas/`, a un clic, con el enlace de abajo.
 *
 * ── Se descartan las respuestas que dependen de su pregunta ─────────────────
 * La respuesta del hotel a «¿Aceptan niños?» es, literalmente, «Sí.», y la de
 * «¿Puedo llegar después de las 15:00?» empieza por «Sí, a cualquier hora».
 * Sacadas de su pregunta quedan como afirmaciones sueltas que no informan de
 * nada: bajo la etiqueta «Menores», un «Sí.» a secas; detrás del horario, un
 * «Sí, a cualquier hora» que parece contradecirlo.
 *
 * Las dos se quedan en las preguntas frecuentes, junto a la pregunta que les da
 * sentido. Reescribirlas para que funcionaran aquí sería inventar texto del
 * hotel, y este bloque existe precisamente para no hacerlo.
 *
 * **La regla:** una respuesta sólo se puede reutilizar fuera de su FAQ si se
 * sostiene sola. «Amamos las mascotas, pero por ahora no podemos recibirlas» sí;
 * «Sí.» no.
 */
const bloques = [
  horarios && {
    titulo: t('practicos.horarios'),
    puntos: [horarios.puntos[0][idioma]],
  },
  mascotas && { titulo: t('practicos.mascotas'), puntos: [mascotas.r[idioma]] },
].filter(Boolean) as { titulo: string; puntos: string[] }[];

---
{bloques.length > 0 && (
  <section class="practicos" aria-labelledby="practicos-titulo">
    <h2 class="practicos__titulo" id="practicos-titulo">{t('practicos.titulo')}</h2>
    <dl class="practicos__lista">
      {bloques.map((b) => (
        <div class="practicos__fila">
          <dt>{b.titulo}</dt>
          <dd>
            {b.puntos.map((x) => <p>{x}</p>)}
          </dd>
        </div>
      ))}
    </dl>
    <p class="practicos__accion">
      <a href={ruta(idioma, 'politicas')}>{t('practicos.ver')}</a>
    </p>
  </section>
)}

<style>
  .practicos {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .practicos__titulo {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-antetitulo);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-5);
  }

  /* `<dl>` y no una tabla ni una lista: cada fila es un TÉRMINO y su
     definición, que es literalmente lo que un lector de pantalla anuncia. Con
     `<ul>` se pierde la relación entre «Mascotas» y su respuesta. */
  .practicos__lista { margin: 0; display: grid; gap: var(--space-5); }
  .practicos__fila { display: grid; gap: var(--space-1); }
  @media (min-width: 34rem) {
    .practicos__fila { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-4); }
  }
  .practicos__fila dt {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .practicos__fila dd { margin: 0; }
  .practicos__fila dd p {
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    margin: 0 0 var(--space-2);
  }
  .practicos__fila dd p:last-child { margin-bottom: 0; }

  .practicos__accion { margin: var(--space-5) 0 0; }
  .practicos__accion a {
    display: inline-block;
    min-height: 32px; line-height: 32px;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
</style>
