---
/**
 * «Qué hacer en Tulum» — rejilla de cuatro, con el texto DENTRO de la tarjeta.
 *
 * Formato pedido por el cliente (2026-09-01): «un layout con imágenes dividido
 * en grid de 4 donde se muestren fotos y dentro de esas fotos una breve
 * descripción, algo así como las imágenes que se usan para las recámaras».
 *
 * ── DOS MODOS, Y AHORA CORREN LOS DOS ──────────────────────────────────────
 * Cada tarjeta pinta la fotografía si la hay y un GLIFO si no. Desde el
 * 2026-09-02 las ocho llevan fotografía de licencia libre —el archivo del
 * hotel no tenía ni un cenote ni una ruina— y el modo glifo se queda como
 * respaldo: si alguien quita una imagen, la tarjeta no se rompe, se dibuja.
 *
 * 🔴 El texto va en blanco sobre la foto, y su contraste depende de la
 * FOTOGRAFÍA, no de un color. Lo garantiza el velo en degradado de abajo, con
 * la cuenta escrita al lado. Al añadir una foto nueva hay que mirarla.
 *
 * ── POR QUÉ NO SON ENLACES ─────────────────────────────────────────────────
 * Ninguna de las ocho lleva a ninguna parte, y es deliberado. Enlazar a la
 * página de un cenote o de un operador es dar publicidad gratuita —lo que el
 * cliente pidió evitar— y además convierte al hotel en responsable de lo que
 * pase al otro lado del enlace. Son tarjetas informativas, no un directorio.
 */
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { actividades } from '../data/actividades';
import type { Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---
<ul class="actividades" role="list">
  {actividades.map((a) => (
    <li>
      <article class:list={['act', !a.imagen && 'act--glifo']}>
        {/* Espaciador vacío que sólo aporta la PROPORCIÓN. Ver la nota de
            `.act__marco` en el CSS: es lo que hace que 3/4 sea un mínimo y no
            una jaula. */}
        <span class="act__marco" aria-hidden="true"></span>
        {a.imagen ? (
          <Image
            class="act__foto"
            src={a.imagen}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 90vw"
            loading="lazy"
            quality={50}
          />
        ) : (
          /* `aria-hidden`: el glifo no aporta nada que el título no diga ya, y
             anunciar «imagen» ocho veces antes de cada título es ruido puro
             (WCAG 1.1.1, gráfico decorativo acompañado de texto). */
          <span class="act__glifo" aria-hidden="true"><Icono nombre={a.icono} tam={96} /></span>
        )}
        <div class="act__texto">
          {/* <h2> y no <h3>: bajo el <h1> del banner no hay ningún otro
              encabezado, así que estas ocho son las secciones de primer nivel
              de la página. Lo cazó el auditor de accesibilidad —«salto de h1 a
              h3», WCAG 1.3.1—, y es exactamente el defecto que un lector de
              pantalla convierte en «falta un apartado aquí en medio». El nivel
              del encabezado es estructura, no tamaño: el tamaño lo pone el CSS
              y se queda igual. */}
          <h2 class="act__titulo">{a.titulo[idioma]}</h2>
          <p class="act__desc">{a.texto[idioma]}</p>
          {/* `distancia` está en `null` en las ocho hasta que responda C-LLEG.
              Cuando llegue el dato, esta línea aparece sola. */}
          {a.distancia && <p class="act__distancia">{a.distancia[idioma]}</p>}
        </div>
      </article>
    </li>
  ))}
</ul>

<style>
  .actividades {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  /* 🔴 LA PROPORCIÓN ES UN MÍNIMO, NO UNA JAULA. Y se descubrió midiendo.
     La primera versión era `display: flex` con `justify-content: flex-end` y
     `aspect-ratio: 3/4` sobre la propia tarjeta. Se ve perfecta con estos
     textos y a estos anchos — y **recorta en silencio** en cuanto el contenido
     crece: alineado al final, el texto que no cabe se sale por ARRIBA y
     `overflow: hidden` se lo come. Calibrado a propósito con un párrafo tres
     veces más largo: la tarjeta seguía midiendo 290 px y **185 px de texto
     quedaban fuera, empezando por el título**.

     No hacía falta un texto absurdo para provocarlo: a 1024 px de ancho la
     tarjeta más larga ya sólo tenía 22 px de holgura. Una traducción más larga,
     una palabra más, o alguien con el tamaño de letra del navegador subido —que
     es una preferencia de accesibilidad, no un caso raro— y se pierde el
     titular sin que nada avise.

     La solución es un espaciador vacío que comparte celda con el texto: la
     altura de la celda es el MAYOR de los dos. Si el texto cabe, manda la
     proporción 3/4 —la misma de las tarjetas de habitación, que es la
     referencia que dio el cliente—; si no cabe, manda el texto y la tarjeta
     crece. La rejilla iguala después las alturas de cada fila.

     El patrón general: `overflow: hidden` sobre una altura fija no contiene un
     desbordamiento, lo ESCONDE. Cualquier caja de altura fija con texto dentro
     necesita una vía de escape. */
  .act {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }
  .act__marco, .act__texto { grid-area: 1 / 1; }
  /* El espaciador no pinta nada: sólo reclama el alto de la proporción. */
  /* 5/7 y no 3/4 desde que hay fotografías (2026-09-02). Estas tarjetas llevan
     el texto DENTRO, así que texto y foto se reparten la misma caja: con 3/4 el
     texto ocupaba 200 de 373 px y la fotografía quedaba en una franja. El
     cliente pidió fotos, no fondos. Un poco más de alto —y textos recortados a
     una sola frase— devuelven la imagen a dos tercios de la tarjeta. */
  .act__marco { aspect-ratio: 5 / 7; }
  .act__texto { align-self: end; }

  /* --- Modo GLIFO (respaldo desde que hay fotografías) ---------------------
     Fondo cálido y texto en tinta: 15.9:1, sin nada que medir. El glifo va
     grande y muy tenue detrás del texto — ilustra sin competir con él. */
  .act--glifo { background: linear-gradient(150deg, var(--color-surface-warm), var(--color-surface-alt)); }
  .act__glifo {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    align-content: start;
    padding-top: var(--space-7);
    color: var(--color-accent);
    opacity: 0.42;
    z-index: -1;
  }
  .act--glifo .act__titulo { color: var(--color-ink); }
  .act--glifo .act__desc { color: var(--color-ink-muted); }

  /* --- Modo FOTOGRAFÍA -----------------------------------------------------
     🔴 EL VELO CUELGA DEL TEXTO, NO DE LA TARJETA. Y el motivo es una medición
     que salió mal.

     La primera versión ponía el degradado sobre la TARJETA, con la banda densa
     en el 38 % inferior. Se veía bien. Medido con las ocho fotos puestas,
     resultó que el texto no siempre cabe en ese 38 %: las tarjetas cuyo título
     ocupa dos líneas empujan el párrafo hacia arriba, y ahí el velo ya se ha
     aclarado. Los números, con el ancho de escritorio:

       tarjeta con título de 1 línea   texto arranca al 51 %   alfa 0.55   4.7:1
       «La carretera de Boca Paila»    texto arranca al 58 %   alfa 0.42   3.0:1
       «Zona arqueológica de Tulum»    texto arranca al 64 %   alfa 0.33   **2.3:1**

     Dos de las ocho por debajo del 4.5:1 de WCAG 1.4.3, y la peor a menos de la
     mitad. A ojo no se notaba porque esas dos fotos son oscuras justo ahí — es
     decir, cumplían por SUERTE, no por diseño. Cambiar una foto por otra más
     clara habría roto el texto sin tocar una línea de CSS.

     La solución no es subir la banda: es que el velo deje de depender de la
     altura del texto. Ahora el degradado va sobre `.act__texto`, que es
     exactamente la caja que contiene las letras, con un desvanecido de 2.5rem
     por arriba y ese mismo relleno para que la primera línea nunca caiga
     dentro del desvanecido. Mida lo que mida el texto, el velo lo cubre.

     Alfa 0.75 sobre el peor caso posible —una fotografía blanca pura— da un
     fondo sRGB de 64: **10.4:1** con el blanco. Ya no hay que volver a medir
     al cambiar una foto, que era el verdadero problema.

     El degradado de la tarjeta se queda, mucho más suave: ya no protege nada,
     sólo asienta la imagen contra el borde inferior. */
  .act__foto {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .act:not(.act--glifo)::after {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.30) 0%,
      rgb(0 0 0 / 0.12) 45%,
      rgb(0 0 0 / 0) 100%);
  }
  /* El velo que de verdad garantiza el contraste, colgado del propio texto. */
  .act:not(.act--glifo) .act__texto {
    padding-top: 2.5rem;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.75) 0%,
      rgb(0 0 0 / 0.75) calc(100% - 2.5rem),
      rgb(0 0 0 / 0) 100%);
  }
  .act:not(.act--glifo) .act__titulo,
  .act:not(.act--glifo) .act__desc,
  .act:not(.act--glifo) .act__distancia { color: #fff; }

  /* --- Texto ---------------------------------------------------------------
     `position: relative` sin z-index propio: los dos fondos van a `z-index:-1`
     dentro del `isolate` de la tarjeta, así que el texto queda encima sin
     necesidad de apilar nada. */
  .act__texto { position: relative; padding: var(--space-5); }
  .act__titulo {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
    margin-bottom: var(--space-2);
  }
  /* `line-height` más corto que el del cuerpo del sitio: sobre una fotografía
     un bloque muy aireado se lee PEOR, no mejor — el ojo pierde el renglón
     cuando el fondo tiene detalle. */
  .act__desc { font-size: var(--text-sm); line-height: 1.5; }
  .act__distancia {
    margin-top: var(--space-3);
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--color-accent-text);
  }

  /* Dos columnas en tableta, CUATRO en escritorio — la rejilla que pidió el
     cliente. 64rem y no 60: a 60rem cada tarjeta caía a 232 px de ancho y el
     título de tres palabras se partía en cuatro renglones. */
  @media (min-width: 40rem) { .actividades { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .actividades { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
