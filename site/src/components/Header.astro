---
/**
 * Cabecera.
 *
 * Dos modos, controlados por `sobreHero`:
 *
 * - `true`  — se posa SOBRE la fotografía del héroe, transparente y en blanco.
 *             Es la composición de Cappa y lo que produce la primera impresión.
 * - `false` — sólida y pegada arriba, para las páginas sin héroe a sangre.
 *
 * Cappa cambia de transparente a sólida al hacer scroll con jQuery. Aquí no hay
 * JavaScript: sobre el héroe la cabecera acompaña al scroll y desaparece con él.
 * La alternativa —fija y translúcida— dejaría texto blanco sobre el contenido
 * claro de abajo, que es un fallo de contraste, no una decisión estética.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/logo-azucar.webp';
import Icono from './Icono.astro';
import { usarT, ruta, ancla, idiomas, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma; rutaActual?: string; sobreHero?: boolean }
const { idioma, rutaActual = '', sobreHero = false } = Astro.props;
const t = usarT(idioma);

// ── EL MENÚ, TAL Y COMO LO PIDIÓ EL CLIENTE (2026-09-01) ───────────────────
//
// Antes había SIETE apartados planos y un solo desplegable, el de alojamiento,
// con los ocho tipos cableados a mano dentro de la plantilla. El cliente pidió
// una jerarquía distinta —«Amenidades» y «Eventos» con hijos propios— y eso ya
// no cabía en un `submenu: true` booleano.
//
// Se normaliza ANTES de la plantilla: aquí se resuelven etiquetas y `href`, y
// abajo sólo hay un bucle que no sabe de dónde viene cada hijo. Es la razón de
// que los ocho tipos de alojamiento (que vienen de una colección) y los cinco
// apartados de amenidades (que vienen del diccionario) se pinten con el mismo
// marcado sin un solo `if` extra en el HTML.
//
// 🔴 REGLA QUE NO SE ROMPE: **sólo se enlaza lo que existe**. Un `href` en
// `null` se pinta como texto, no como enlace — es el caso del Spa, que se
// anuncia como «próximamente» porque el hotel no ha dicho una sola palabra
// sobre él más allá de la palabra suelta en su lista de amenidades. Un
// apartado de menú que lleva a una página vacía cuesta más confianza que un
// apartado que dice honestamente que aún no está.
//
// Y los que SÍ enlazan se comprueban solos: los `#anclas` los verifica el
// guardián «fragmentos de URL sanos» de `verificar-todo.sh`, que falla si el
// `id` no existe en la página de destino.
type Hijo = { etiqueta: string; href: string | null; nota?: string };
type Entrada = {
  etiqueta: string;
  /** Página propia del apartado. Ausente en los que sólo agrupan. */
  href?: string;
  /**
   * Las rutas que este apartado POSEE, para marcar «estás aquí».
   *
   * Es una lista y no una sola ruta por dos motivos que aparecieron a la vez:
   *
   *   · «Antes de viajar» no tiene página propia — agrupa cuatro que sí la
   *     tienen. Sin esto, estar en /politicas/ no encendía nada en la barra.
   *   · Y estando en la ficha de un bungalow tampoco se encendía «Alojamiento»,
   *     porque `rutaActual` es `alojamiento/bungalow-mar` y no `alojamiento`.
   *     Llevaba así desde el sprint 2 y nadie lo había visto: quien navega por
   *     el catálogo no tenía ni una pista de dónde estaba.
   *
   * El prefijo se compara con `/` detrás a propósito: sin él, `politicas`
   * marcaría también una futura `politicas-de-grupo`.
   */
  rutas: string[];
  hijos?: Hijo[];
};

const tipos = (await getCollection('alojamiento', (x) => x.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);

const enlaces: Entrada[] = [
  { etiqueta: t('nav.nosotros'), rutas: ['nosotros'], href: ruta(idioma, 'nosotros') },
  {
    etiqueta: t('nav.alojamiento'),
    rutas: ['alojamiento'],
    href: ruta(idioma, 'alojamiento'),
    hijos: [
      { etiqueta: t('nav.verTodo'), href: ruta(idioma, 'alojamiento') },
      ...tipos.map((x) => ({
        etiqueta: x.data.nombre[idioma],
        href: ruta(idioma, `alojamiento/${x.id}`),
      })),
    ],
  },
  {
    etiqueta: t('nav.amenidades'),
    rutas: ['servicios', 'restaurante'],
    href: ruta(idioma, 'servicios'),
    hijos: [
      { etiqueta: t('nav.verTodoAmenidades'), href: ruta(idioma, 'servicios') },
      { etiqueta: t('nav.restaurante'), href: ruta(idioma, 'restaurante') },
      // Sin `href`: el spa no está. Ver `instalaciones` en `src/data/hotel.ts`.
      { etiqueta: t('nav.spa'), href: null, nota: t('nav.proximamente') },
      { etiqueta: t('nav.daypass'), href: `${ruta(idioma, 'servicios')}#daypass` },
      { etiqueta: t('nav.rooftopSelvamar'), href: `${ruta(idioma, 'servicios')}#rooftop-selvamar` },
      { etiqueta: t('nav.rooftopWhitePearl'), href: `${ruta(idioma, 'servicios')}#rooftop-white-pearl` },
    ],
  },
  { etiqueta: t('nav.galeria'), rutas: ['galeria'], href: ruta(idioma, 'galeria') },
  {
    etiqueta: t('nav.eventos'),
    rutas: ['eventos'],
    href: ruta(idioma, 'eventos'),
    hijos: [
      { etiqueta: t('nav.verTodoEventos'), href: ruta(idioma, 'eventos') },
      { etiqueta: t('nav.eventosInfo'), href: `${ruta(idioma, 'eventos')}${ancla(idioma, 'eventosInfo')}` },
      { etiqueta: t('nav.eventosVisita'), href: `${ruta(idioma, 'eventos')}${ancla(idioma, 'eventosVisita')}` },
    ],
  },
  // Apartado SUELTO, no colgado de «Amenidades» (cliente, 2026-09-01). Lo de
  // esa página no es del hotel: las amenidades son lo que el hotel ofrece y por
  // lo que responde; esto es el entorno, sobre el que no responde nadie.
  { etiqueta: t('nav.actividades'), rutas: ['actividades'], href: ruta(idioma, 'actividades') },
  /**
   * ── «ANTES DE VIAJAR» — el único apartado SIN página propia ───────────────
   * Nace el 2026-09-02: ocho apartados eran demasiados y el cliente pidió
   * juntar FAQ y Políticas. Aquí caben cuatro, y no por hacer sitio: son las
   * cuatro páginas que consulta quien YA decidió venir, frente a las otras
   * seis, que existen para convencer. Agruparlas por INTENCIÓN y no por tipo
   * de contenido es lo que hace que la barra se lea de un vistazo.
   *
   * 🔴 Y recupera dos páginas. «Cómo llegar» y «Contacto» salieron de la barra
   * el 2026-09-01 porque no cabían, y se quedaron sólo en el pie. Vuelven aquí
   * sin salir de él: quien las busca las encuentra en los dos sitios.
   *
   * NO tiene `href`: no hay una página «Antes de viajar» y no se va a inventar
   * una para que el rótulo lleve a algún lado. El `<summary>` abre el panel,
   * que es lo que hace en los otros tres desplegables — la diferencia es que
   * aquí tampoco hay un «Ver todo».
   */
  {
    etiqueta: t('nav.antesDeViajar'),
    rutas: ['preguntas-frecuentes', 'politicas', 'ubicacion', 'contacto', 'aviso-de-privacidad'],
    hijos: [
      { etiqueta: t('nav.faq'), href: ruta(idioma, 'preguntas-frecuentes') },
      { etiqueta: t('nav.politicas'), href: ruta(idioma, 'politicas') },
      { etiqueta: t('nav.ubicacion'), href: ruta(idioma, 'ubicacion') },
      { etiqueta: t('nav.contacto'), href: ruta(idioma, 'contacto') },
    ],
  },
];

/** «Estás aquí»: la ruta actual, o cualquier página colgada de ella. */
const esActual = (e: Entrada) =>
  e.rutas.some((r) => rutaActual === r || rutaActual.startsWith(`${r}/`));

const otro: Idioma = idioma === 'es' ? 'en' : 'es';
---
<header class:list={['cabecera', sobreHero && 'cabecera--sobre-hero']}>
  <div class="contenedor cabecera__fila">
    {/* El logotipo REAL del hotel, tomado de su sitio vigente
        (`logo_azucar_dorado-png.webp`, 310 × 193, con transparencia).

        Antes había un wordmark tipográfico —«Azucar» en Gilda Display con
        «Hotel Tulum» debajo— que compuse para tener algo mientras. No era el
        logotipo del hotel: la cúpula dorada, la palabra manuscrita «Hotel» y
        las líneas turquesa son su identidad, y ninguna estaba ahí.

        `alt` con el nombre del hotel y no «logotipo»: quien no ve la imagen
        necesita saber a dónde lleva el enlace, no de qué tipo de gráfico se
        trata (WCAG 1.1.1). */}
    <a class="marca" href={ruta(idioma)}>
      <Image
        class="marca__logo"
        src={logo}
        alt="Azucar Hotel Tulum"
        widths={[112, 224]}
        sizes="112px"
        loading="eager"
      />
    </a>

    {/* Navegación horizontal, sólo en escritorio. Es la pieza que más distingue
        visualmente a Cappa y la que faltaba: antes el escritorio sólo mostraba
        idioma y botón, lo que dejaba la cabecera vacía. */}
    {/* Los dos <nav> de la cabecera —el horizontal de escritorio y el del cajón
      móvil— llevaban la MISMA etiqueta, «Menú». Sólo uno se renderiza a la vez,
      así que en la práctica no molestaba a nadie; aun así, dos landmarks del
      mismo tipo con nombre idéntico son ambiguos por definición y no cuesta
      nada distinguirlos. Lo encontró `html-validate`; mi propio auditor pedía
      que las <nav> tuvieran nombre, no que fuera ÚNICO. */}
  <nav class="nav" aria-label={t('nav.principal')}>
      <ul class="nav__lista">
        {enlaces.map((e) => (
          <li>
            {e.hijos ? (
              /* <details> y no un <button> con JavaScript: el navegador ya
                 gestiona el estado, el teclado —Enter y Espacio— y anuncia
                 «contraído / expandido» al lector de pantalla sin sincronizar un
                 `aria-expanded` a mano. Cappa deja ese atributo fijo en «false»
                 y no lo actualiza nunca: quien use lector de pantalla oye
                 «contraído» también con el menú abierto. */
              <details class="desplegable">
                <summary
                  class="desplegable__disparador"
                  aria-current={esActual(e) ? 'page' : undefined}
                >
                  <span>{e.etiqueta}</span>
                  <span class="desplegable__flecha" aria-hidden="true"></span>
                </summary>
                <ul class="desplegable__panel">
                  {e.hijos.map((h) => (
                    <li>
                      {h.href ? (
                        <a href={h.href}>{h.etiqueta}</a>
                      ) : (
                        /* Sin `href` no es un enlace: es texto. Un <a> sin
                           destino no recibe foco de teclado y anuncia «enlace»
                           a un lector de pantalla sin llevar a ningún sitio. */
                        <span class="desplegable__inerte">
                          {h.etiqueta}
                          <em class="etiqueta-pronto">{h.nota}</em>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={e.href}
                aria-current={esActual(e) ? 'page' : undefined}
              >{e.etiqueta}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    {/* El <details> da un menú desplegable accesible sin una línea de JS: el
        navegador gestiona el estado, el teclado y el anuncio del estado
        expandido al lector de pantalla. Cappa usaba jQuery para esto.

        Este comentario usa la sintaxis de llaves y NO la de HTML: Astro
        descarta la primera al compilar y conserva la segunda. Éste era el único
        comentario HTML del proyecto y viajaba en las 38 páginas — 8.5 KB de
        notas internas enviadas a cada visitante. Nadie lo iba a ver salvo quien
        mirase el código fuente, que es justo el motivo de que llevara tanto
        tiempo ahí.

        Y cuidado al reescribir esta nota: una secuencia de cierre de comentario
        dentro del propio texto lo termina antes de tiempo y rompe el build.
        Pasó exactamente al escribirla. */}
    <details class="menu">
      <summary class="menu__boton" aria-label={t('nav.menu')}>
        <span aria-hidden="true" class="menu__icono"></span>
        <span class="sr-only">{t('nav.menu')}</span>
      </summary>
      <nav class="menu__panel" aria-label={t('nav.menu')}>
        <ul class="menu__lista">
          {enlaces.map((e) => (
            <li>
              {e.hijos ? (
                /* En el cajón el mismo submenú es un acordeón ANIDADO, no un
                   panel flotante: es lo que hace Cappa en móvil —su submenú pasa
                   a `position: static`— y es lo correcto, porque un panel
                   absoluto dentro de un cajón que ya scrollea se sale de la
                   pantalla. Aquí no hay hover: en una pantalla táctil no existe,
                   y dejarlo produce el «hover pegajoso» de la primera pulsación. */
                <details class="submenu">
                  <summary class="submenu__disparador">
                    <span>{e.etiqueta}</span>
                    <span class="submenu__flecha" aria-hidden="true"></span>
                  </summary>
                  <ul class="submenu__lista">
                    {e.hijos.map((h) => (
                      <li>
                        {h.href ? (
                          <a
                            href={h.href}
                            aria-current={h.href === e.href && esActual(e) ? 'page' : undefined}
                          >{h.etiqueta}</a>
                        ) : (
                          <span class="submenu__inerte">
                            {h.etiqueta}
                            <em class="etiqueta-pronto">{h.nota}</em>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={e.href}
                  aria-current={esActual(e) ? 'page' : undefined}
                >{e.etiqueta}</a>
              )}
            </li>
          ))}
        </ul>
        <div class="menu__pie">
          <a
            class="menu__idioma"
            href={ruta(otro, rutaActual)}
            lang={otro}
            hreflang={otro}
            aria-label={idiomas[otro]}
          >
            <Icono nombre="mundo" tam={18} />
            <span aria-hidden="true">{otro.toUpperCase()}</span>
          </a>
          <a class="boton boton--primario" href={ruta(idioma, 'reservar')}>{t('reserva.cta')}</a>
        </div>
      </nav>
    </details>

    <div class="cabecera__acciones">
      {/* Antes decía «ENGLISH» / «ESPAÑOL» en texto completo: la palabra más
          larga de toda la cabecera, y con más peso visual que «Alojamiento» o
          «Preguntas frecuentes» a su lado. Se reduce al código de dos letras
          —EN / ES, norma ISO 639-1— más el mismo glifo de mundo que usa Cappa
          en su propio selector (`ti-world`, sin ninguna bandera en la
          plantilla). El nombre completo del idioma no desaparece: sigue siendo
          el nombre accesible del enlace, vía `aria-label` (WCAG 2.4.4, el
          propósito del enlace determinado por su texto). */}
      <a
        class="cabecera__idioma"
        href={ruta(otro, rutaActual)}
        lang={otro}
        hreflang={otro}
        aria-label={idiomas[otro]}
      >
        <Icono nombre="mundo" tam={16} />
        <span aria-hidden="true">{otro.toUpperCase()}</span>
      </a>
      <a class="boton boton--primario" href={ruta(idioma, 'reservar')}>{t('reserva.cta')}</a>
    </div>
  </div>
</header>

<script>
  /**
   * Cerrar el menú con `Esc` — WCAG 2.2 AA, criterio 1.4.13 «Content on Hover
   * or Focus», apartado *Dismissible*.
   *
   * ── POR QUÉ HACE FALTA JAVASCRIPT AQUÍ, CON LO CELOSOS QUE SOMOS ────────────
   * El desplegable se abre al pasar el ratón y tapa contenido de la página. El
   * criterio exige poder descartarlo **sin mover el puntero ni el foco**, y eso
   * es exactamente lo único que el CSS no puede hacer: un estado `:hover` sólo
   * se retira moviendo el ratón.
   *
   * Todo lo demás —abrir, cerrar, teclado, anuncio de contraído/expandido— lo
   * resuelve `<details>` sin una línea de código. Esto son 22 líneas para cubrir
   * el hueco, no un gestor de menús.
   *
   * De paso cierra el cajón móvil con `Esc`, que antes tampoco se cerraba, y
   * devuelve el foco a su disparador para no dejarlo en un elemento oculto.
   */
  const cabecera = document.querySelector('header.cabecera');
  if (cabecera) {
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      const abiertos = [...cabecera.querySelectorAll<HTMLDetailsElement>('details[open]')];
      if (!abiertos.length) return;
      // Del más interno al más externo: `Esc` cierra un nivel por pulsación, que
      // es lo que espera quien tiene un submenú abierto dentro del cajón.
      const objetivo = abiertos[abiertos.length - 1];
      objetivo.open = false;
      objetivo.querySelector<HTMLElement>('summary')?.focus();
    });

    // Un clic fuera cierra el desplegable de escritorio. Sin esto queda abierto
    // tras pulsarlo, porque `<details>` sólo se cierra con su propio disparador.
    document.addEventListener('click', (ev) => {
      for (const d of cabecera.querySelectorAll<HTMLDetailsElement>('.desplegable[open]')) {
        if (!d.contains(ev.target as Node)) d.open = false;
      }
    });
  }
</script>

<style>
  .cabecera {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  /* Sobre el héroe: sin fondo, sin borde y en blanco. `absolute` y no `sticky`
     para que se vaya con la foto en vez de quedarse flotando sobre el contenido. */
  .cabecera--sobre-hero {
    position: absolute; inset-inline: 0; top: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 0;
  }

  .cabecera__fila {
    display: flex; align-items: center; justify-content: space-between;
    /* 16 px y no 24, y es **gratis visualmente**. Con `space-between` este
       `gap` sólo es un MÍNIMO: en cuanto sobra ancho —de 1200 px en adelante,
       que es donde vive casi todo el mundo— los huecos reales los decide el
       espacio libre y este número no se nota. Donde sí actúa es en el extremo
       estrecho, y ahí cada píxel es rango de pantallas que conservan el menú
       horizontal en vez de la hamburguesa.
       Medido: el ancho mínimo de la fila era 1159 px con el umbral en 1152 —es
       decir, se pasaba por 7—. Estos 16 px lo bajan a 1143 y dejan margen real. */
    gap: var(--space-4);
    min-height: var(--alto-cabecera);
  }
  /* `flex: none` — el logo NUNCA se encoge. Es el único hijo de la fila sin
     tamaño fijo, así que cuando el contenido no cabe, el flex lo aplasta a él:
     al añadir «Restaurante» al menú el logotipo pasó de 112×70 a **46×28**
     medidos. Un logo encogido no se lee como decisión, se lee como error. */
  .marca { display: flex; align-items: center; text-decoration: none; flex: none; }
  .marca__logo {
    /* 132 px de ancho — el cliente pidió ampliarlo (2026-09-01).
       A 310 × 193 eso son **90 px de alto**, y la fila mide 104 px: quedan 7 px
       de aire arriba y abajo. No es un número redondo elegido a ojo, es el
       máximo que cabe con el aire de la plantilla; `--alto-cabecera` subió de
       88 a 104 px justo para esto, y `--desplazamiento-ancla` va detrás porque
       se calcula a partir de él (si no, la cabecera pegajosa taparía el destino
       de cada `#ancla`).
       Alto automático desde la proporción real, así no hay CLS. */
    width: 144px;
    height: auto;
  }
  .marca:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .nav { display: none; }
  .nav__lista {
    /* 11 px, y es un número medido, no una talla de la escala.
       Cuarto ajuste de este hueco: 24 px con seis apartados, 16 con siete, 12
       con ocho y ahora 11 con siete otra vez. Que baje aun quitando un apartado
       tiene explicación: «Antes de viajar» mide 121 px y las dos etiquetas que
       sustituye sumaban 97.
       Medido a 1152 px —el umbral de escritorio— la fila encajaba con **cero
       holgura**: los huecos entre logotipo, menú y acciones se quedaban en su
       mínimo de 24 px exactos, sin un píxel de sobra. Nada comprimido, pero
       tampoco margen: una traducción más larga, otra métrica de fuente o
       alguien con el tamaño de letra del navegador subido —que es una
       preferencia de accesibilidad, no un caso raro— y desborda.
       De 12 a 11 en los seis huecos son 6 px; con los 8 del botón, 14 px de
       holgura real. Ninguno de los dos se nota; el desbordamiento sí. */
    display: flex; align-items: center; gap: 11px;
    list-style: none; padding: 0; margin: 0;
  }
  /* `> li > a`: SÓLO los enlaces de primer nivel.
     Escrito como `.nav__lista a` alcanzaba también los del panel desplegable, y
     sobre el héroe —donde estos van en blanco— el panel quedaba con nueve
     enlaces blancos sobre fondo blanco. No lo vio ninguna medición: el panel
     estaba ahí, con su altura y sus 44 px por enlace, y `getComputedStyle`
     decía «blanco» sin que nada dijera que debajo también era blanco. Lo enseñó
     una captura de pantalla. */
  .nav__lista > li > a {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    /* 0.12em. Cappa usa 0.20em y aquí ya se había bajado a 0.16 por espacio;
       con ocho apartados hacen falta otros 35 px medidos. Sigue siendo tracking
       ancho —se lee como navegación de hotel, no como texto corrido— y sólo
       aplica en escritorio, que es donde vive esta barra. */
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    white-space: nowrap;
    /* Cappa: `transition: all .4s` en su `.nav-link` (línea 851 de su
       `style.css`). Se copia sólo el color —animar `all` incluye layout y es
       caro—, y se respeta a quien pide menos movimiento. Sin transición el
       cambio es tan brusco que se lee como un parpadeo, no como respuesta. */
    transition: color 0.35s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__lista > li > a { transition: none; }
  }

  /* 🎨 EL HOVER ES SÓLO UN CAMBIO DE COLOR, COMO EN LA PLANTILLA.
     Medido en el CSS de Cappa, `.navbar .navbar-nav .nav-link:hover { color:
     #aa8453 }` — su oro, sin subrayado ni nada más. Aquí tenía además un
     `border-bottom` que se encendía al pasar el ratón, y esa raya se comía el
     protagonismo del color: el cliente pidió el hover dos veces porque lo que
     veía era la línea, no la fuente.
     El subrayado NO desaparece: se queda para `aria-current`, marcando la
     página actual. Un mismo adorno para «estás aquí» y para «el ratón está
     encima» dice dos cosas con un solo signo. */
  .nav__lista > li > a:hover { color: var(--color-accent-text); }
  .nav__lista > li > a[aria-current='page'] {
    color: var(--color-accent-text);
    border-bottom-color: var(--color-accent);
  }

  .cabecera__acciones { display: none; align-items: center; gap: var(--space-4); }
  /* El botón de la cabecera NUNCA se parte en dos líneas.
     Al subir la separación de letras del selector de idioma de 0.12em a 0.20em
     —para igualar la navegación de Cappa— la fila creció ocho píxeles y eso
     bastó para que «Solicitar reserva» pasara a dos renglones. Ocho píxeles.
     La cabecera iba al límite y nadie lo sabía porque nunca se había medido. */
  .cabecera__acciones .boton { white-space: nowrap; }
  /* Más pequeño que `.boton` en cualquier otro sitio del sitio —del héroe al
     pie—, y SÓLO aquí: en la barra comparte fila con enlaces de texto de
     14 px, y a 44 px de alto con relleno de `--space-6` se veía más grande que
     el propio logotipo. Se reduce a 40 px: sigue por encima del mínimo de
     24 px de WCAG 2.5.8 —no es un objetivo táctil de móvil, es un puntero fino
     en escritorio, donde vive esta barra— y dos tallas de relleno, no una: si
     sólo bajara el alto sin bajar el relleno lateral la etiqueta seguiría
     leyéndose desproporcionada frente a «Contacto» o «Alojamiento» de al lado. */
  .cabecera__acciones .boton {
    min-height: 40px;
    /* 20 px de relleno lateral y no 24: ocho píxeles que en un botón de 170 px
       no ve nadie, y que son la mitad de la holgura de toda la fila. */
    padding: var(--space-2) 20px;
    font-size: var(--text-sm);
  }
  /* `inline-flex` y no el `inline` por defecto: en un <a> inline el padding
     vertical NO cuenta para la altura de la caja, así que el enlace medía 23 px
     y no llegaba al mínimo de 24 px de WCAG 2.2 AA 2.5.8. Es el mismo defecto
     que ya apareció en el pie, y sigue siendo invisible a ojo. */
  .cabecera__idioma {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-nav); text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
    padding-inline: var(--space-2);
  }
  .cabecera__idioma { transition: color 0.35s ease; }
  .cabecera__idioma:hover { color: var(--color-accent-text); }

  /* --- Variante sobre fotografía -------------------------------------------
     Todo lo que va sobre la foto pasa a blanco puro. Sobre el velo del héroe
     (0.3 plano + degradado) el blanco da 7:1 largo, muy por encima del 4.5:1. */
  /* ⚠️ MARGEN MEDIDO, Y ES ESTRECHO.
     Sobre el héroe estos textos son blancos y su legibilidad depende de la
     FOTOGRAFÍA que haya debajo, no de un color. Medido sobre los píxeles reales
     de `hero-roof-top.webp`, componiendo el degradado de `.hero__velo`
     (34 % de negro arriba, 6 % al 20 % del alto), en 18 muestras por elemento:

         escritorio 1280 px   logo 5.30:1 · subtítulo 4.93:1 · nav 4.93:1
         móvil       320 px   logo 9.42:1 · subtítulo 9.60:1

     El mínimo AA para texto pequeño es 4.5:1. En escritorio quedan **4.93:1**:
     pasa, con un 10 % de margen. Es el punto más ajustado del sitio.

     🔴 Si se cambia la fotografía del héroe por una más clara en su franja
     superior, esto DEJA DE CUMPLIR y no lo detecta ningún auditor de marcado.
     Hay que volver a medir. La alternativa estructural sería añadir un velo
     propio a la cabecera, a costa de la composición de Cappa. */
  .cabecera--sobre-hero .nav__lista > li > a,
  .cabecera--sobre-hero .cabecera__idioma { color: #fff; }

  /* 🟡 EL LOGOTIPO VA EN DORADO TAMBIÉN SOBRE LA FOTO — cliente, 2026-09-01.
     Antes se aplastaba a blanco con `brightness(0) invert(1)`: se conservaba la
     silueta y se perdía el color, porque los marrones del logotipo desaparecen
     sobre una foto oscura.

     Ahora se pinta el logotipo REAL, y para que el marrón no se pierda se le
     sube el brillo y la saturación en vez de sustituirlo por otro color: los
     trazos dorados suben a dorado claro y la palabra «AZUCAR» deja de ser un
     marrón apagado. La sombra proyectada es lo que le da borde contra
     cualquier zona clara de la fotografía — sin ella, sobre el muro blanco del
     fondo el logotipo se deshace.

     Los valores salen de probarlos en el navegador sobre la foto real, no de
     un cálculo: a 1.35 de brillo la palabra seguía leyéndose marrón sobre la
     madera clara de la terraza. A 1.7 es oro.

     ⚠️ Sigue existiendo UN SOLO archivo de logotipo, dorado sobre transparente,
     y esto es un apaño de CSS sobre él. Lo correcto es una versión clara
     dibujada para fondos oscuros. Es un archivo, no código: queda pedido. */
  .cabecera--sobre-hero .marca__logo {
    filter: brightness(1.7) saturate(1.35)
            drop-shadow(0 1px 4px rgb(0 0 0 / 0.7));
  }
  /* 🟢 SOBRE LA FOTO EL COLOR TAMBIÉN CAMBIA — Y COSTÓ CAMBIAR EL FONDO.
     La primera vez dije que aquí no se podía, y tenía razón con el fondo de
     entonces: el blanco daba 4.93:1 sobre la foto —apenas por encima del 4.5:1
     de WCAG 1.4.3— y cualquier verde reconocible caía a 2.6:1.

     El cliente lo pidió otra vez, así que en lugar de repetir la negativa se
     movió la tercera variable: **el velo del héroe**. Su franja superior pasó
     de 0.34 a 0.52 de negro (ver `.hero__velo` en `Hero.astro`), y con ese
     fondo el pistacho claro `--color-accent-claro` sí pasa. El número medido
     está anotado allí, no aquí, porque el que manda es el del fondo.

     La lección: un requisito que choca con un criterio de accesibilidad casi
     nunca se resuelve eligiendo entre los dos. Se resuelve cambiando lo que
     ninguno de los dos había puesto sobre la mesa. */
  .cabecera--sobre-hero .nav__lista > li > a:hover,
  .cabecera--sobre-hero .desplegable__disparador:hover,
  .cabecera--sobre-hero .desplegable[open] > .desplegable__disparador,
  .cabecera--sobre-hero .cabecera__idioma:hover { color: var(--color-accent-claro); }
  .cabecera--sobre-hero .nav__lista > li > a[aria-current='page'] {
    color: var(--color-accent-claro);
    border-bottom-color: var(--color-accent-claro);
  }
  .cabecera--sobre-hero .menu__icono,
  .cabecera--sobre-hero .menu__icono::before,
  .cabecera--sobre-hero .menu__icono::after { background: #fff; }
  .cabecera--sobre-hero .menu[open] .menu__icono { background: transparent; }

  .menu__boton {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;      /* objetivo táctil accesible */
    cursor: pointer; list-style: none;
  }
  .menu__boton::-webkit-details-marker { display: none; }
  .menu__icono, .menu__icono::before, .menu__icono::after {
    display: block; width: 22px; height: 1.5px; background: var(--color-ink);
    transition: transform var(--dur) var(--ease);
  }
  .menu__icono::before, .menu__icono::after { content: ''; position: relative; }
  .menu__icono::before { top: -7px; }
  .menu__icono::after  { top: 5.5px; }
  .menu[open] .menu__icono { background: transparent; }
  .menu[open] .menu__icono::before { transform: translateY(7px) rotate(45deg); }
  .menu[open] .menu__icono::after  { transform: translateY(-5.5px) rotate(-45deg); }

  .menu__panel {
    position: absolute; left: 0; right: 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-5) var(--gutter) var(--space-6);
  }
  .menu__lista { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .menu__lista a {
    display: block; padding: var(--space-3) 0;
    font-family: var(--font-ui); font-size: var(--text-lg);
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
  }
  .menu__lista a:hover, .menu__lista a[aria-current='page'] { color: var(--color-accent-text); }
  .menu__pie {
    display: flex; align-items: center; gap: var(--space-4);
    margin-top: var(--space-5); padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .menu__idioma {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-nav); text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
  }

  /* 🔴 UMBRAL MEDIDO — TERCERA VEZ, Y ESTA VEZ SÍ SUBE. CON LA CUENTA DELANTE.
     La nota anterior decía, en mis propias palabras: «si algún día se añade
     otro apartado, NO subas este número; acorta una etiqueta». La regla era
     buena y por eso lo primero fue intentar cumplirla. No da.

     Lo que cambió desde entonces son DOS decisiones del cliente (2026-09-01),
     no un descuido: el logotipo creció de 112 a 144 px de ancho —+32— y el menú
     pasó de siete apartados a ocho. Entre las dos se comieron el margen.

     Medido en el navegador, no estimado. Ancho que necesita la fila:

       logotipo 144 + navegación 684 + acciones 229 + 2 huecos de 24  = 1105 px
       con hueco de 12 px y tracking 0.12em                          = 1040 px

     A 1088 px —el umbral viejo— el contenedor sólo ofrece 1001 px de ancho
     útil, así que 1040 DESBORDA. El primer umbral donde cabe con margen real es
     72rem = 1152 px, que deja 1065 útiles: **25 px de sobra**.

     Antes de subirlo se probó lo que decía la nota vieja: bajar el tracking a
     0.10em y el hueco a 10 px da 1007 px y ni así entra en 1088. Acortar más
     etiquetas significaba tocar las que el cliente dictó.

     Qué se pierde: entre 1088 y 1152 px sale la hamburguesa. Son los portátiles
     de 1152×720; a partir de 1280 —la resolución más común— no cambia nada.

     🔴 LA REGLA SIGUE EN PIE, Y AHORA MÁS: **ocho apartados es el techo**. El
     noveno no cabe ni tocando el tracking. Si hace falta uno más, sale otro. */
  @media (min-width: 72rem) {
    .menu { display: none; }
    .nav { display: block; }
    .cabecera__acciones { display: flex; }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     DESPLEGABLE DE ESCRITORIO — patrón `.dropdown` de Cappa

     Medido sobre `demo1-light/index11.html`: panel blanco de 190 px, `padding:
     15px`, `box-shadow: 0 16px 50px rgb(0 0 0 / .07)`, sin borde, revelado con
     `opacity` y `visibility` (no con `display`, para que pueda animarse).

     ── POR QUÉ `<details>` Y NO UN `<button>` CON JAVASCRIPT ────────────────
     El navegador ya gestiona el estado, el teclado —Enter y Espacio— y anuncia
     «contraído / expandido» sin sincronizar nada a mano. Cappa deja
     `aria-expanded="false"` fijo en el disparador y nunca lo actualiza: quien
     use lector de pantalla oye «contraído» también con el menú abierto.

     El truco que lo hace posible: un `<details>` cerrado oculta su contenido
     con la hoja del navegador, y `display: block` lo anula. Comprobado en el
     motor antes de construirlo. Así el panel puede existir siempre y sólo
     cambiar de opacidad. */
  .desplegable { position: relative; }

  .desplegable__disparador {
    /* Un <summary> no es un <a>: el selector `.nav__lista > li > a` no lo
       alcanza, así que se quedaba con la tipografía por defecto del navegador
       —tamaño de párrafo, sin versalitas ni tracking— mientras sus seis
       hermanos llevaban la tipografía de `--font-ui` en mayúsculas espaciadas.
       «Alojamiento» era el único enlace de la barra que no vestía igual que
       los demás. Mismas cinco declaraciones que `.nav__lista > li > a`, línea
       por línea. */
    display: inline-flex; align-items: center; gap: var(--space-2);
    cursor: pointer; list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    /* la altura mínima es del enlace de al lado; ver `.nav__lista a` */
  }
  .desplegable__disparador::-webkit-details-marker { display: none; }
  .desplegable__flecha {
    width: 0; height: 0;
    border-inline: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    transition: rotate var(--dur) var(--ease);
  }

  .desplegable__panel {
    position: absolute; top: 100%; left: 0; z-index: 60;
    min-width: 15rem;
    list-style: none; margin: 0;
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: 0 16px 50px rgb(0 0 0 / 0.07);
    /* Sin `display: none`: se oculta con visibilidad para poder animarlo, y
       `visibility: hidden` —a diferencia de `opacity: 0` sola— lo saca del
       recorrido de tabulación, que es lo que impide tabular a enlaces que no
       se ven. */
    opacity: 0; visibility: hidden;
    translate: 0 6px;
    transition: opacity var(--dur) var(--ease), visibility var(--dur), translate var(--dur) var(--ease);
  }
  /* Anula el ocultado que aplica el navegador a un <details> cerrado. */
  .desplegable:not([open]) > .desplegable__panel { display: block; }

  .desplegable__panel a {
    display: block;
    min-height: 44px;            /* objetivo táctil, WCAG 2.5.8 */
    padding: var(--space-2) var(--space-3);
    line-height: 1.5;
    display: flex; align-items: center;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink); text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .desplegable__panel a:hover,
  .desplegable__panel a[aria-current='page'] {
    background: var(--color-surface-warm);
    color: var(--color-accent-text);
  }
  /* El «Ver todo…» es SIEMPRE el primer hijo del panel, así que se destaca por
     posición y no por una clase que hubiera que recordar poner. Un selector
     estructural no se puede olvidar al añadir un submenú nuevo. */
  .desplegable__panel > li:first-child > a {
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    margin-bottom: var(--space-2);
  }
  .submenu__lista > li:first-child > a { font-weight: 500; }

  /* Apartado anunciado pero SIN destino — hoy, el Spa. No es un enlace y no
     debe parecerlo: ni cursor de mano, ni foco de teclado, ni el anuncio
     «enlace» de un lector de pantalla. Se ve apagado porque lo está. */
  /* Cada uno hereda la métrica de SU lista, no una propia: el panel de
     escritorio y el acordeón del cajón tienen alturas y tipografías distintas,
     y un apartado inerte con medidas de más se desalinea del resto — se veía
     en el cajón, con «Spa» sangrado respecto a sus hermanos. */
  .desplegable__inerte,
  .submenu__inerte {
    display: flex; align-items: center; gap: var(--space-2);
    color: var(--color-ink-muted);
    font-family: var(--font-ui);
  }
  .desplegable__inerte {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }
  .submenu__inerte {
    min-height: 48px;
    font-size: var(--text-base);
    letter-spacing: 0.04em;
  }
  .etiqueta-pronto {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
    white-space: nowrap;
  }

  /* Abierto por CLIC o teclado — el estado nativo del <details>. */
  .desplegable[open] > .desplegable__panel { opacity: 1; visibility: visible; translate: 0; }
  .desplegable[open] .desplegable__flecha { rotate: 180deg; }
  /* Mismo color de acento que `.nav__lista > li > a:hover`: sin esto,
     «Alojamiento» era el único disparador que no cambiaba de color al pasar el
     ratón ni al abrirse, aunque ya compartiera su tipografía. */
  .desplegable__disparador { transition: color 0.35s ease; }
  .desplegable__disparador:hover,
  .desplegable[open] > .desplegable__disparador { color: var(--color-accent-text); }

  /* Abierto por HOVER — sólo en dispositivos con puntero fino.
     Sin esta condición, una pantalla táctil deja el panel «pegado» tras la
     primera pulsación, porque el navegador simula un hover que no se retira
     hasta que se toca otra cosa. Es el defecto clásico de los menús de hover
     portados a móvil, y la razón de que muchos se sientan rotos en el teléfono. */
  @media (hover: hover) and (pointer: fine) {
    .desplegable:hover > .desplegable__panel,
    .desplegable:focus-within > .desplegable__panel {
      opacity: 1; visibility: visible; translate: 0;
    }
    .desplegable:hover .desplegable__flecha,
    .desplegable:focus-within .desplegable__flecha { rotate: 180deg; }
  }

  .cabecera--sobre-hero .desplegable__disparador { color: #fff; }

  /* ═══════════════════════════════════════════════════════════════════════
     SUBMENÚ DEL CAJÓN MÓVIL — acordeón anidado

     En móvil Cappa pasa su submenú a `position: static` y lo abre con un clic.
     Se hace igual: un panel absoluto dentro de un cajón que ya scrollea acaba
     fuera de la pantalla. Y **sin hover**, por lo dicho arriba. */
  .submenu { border: 0; }
  .submenu__disparador {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;            /* holgado: es el objetivo principal del pulgar */
    cursor: pointer; list-style: none;
    font-family: var(--font-ui); font-size: var(--text-lg);
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-ink);
  }
  .submenu__disparador::-webkit-details-marker { display: none; }
  .submenu__disparador:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .submenu__flecha {
    width: 0; height: 0; flex: none;
    border-inline: 5px solid transparent;
    border-top: 6px solid var(--color-accent);
    transition: rotate var(--dur) var(--ease);
  }
  .submenu[open] .submenu__flecha { rotate: 180deg; }

  .submenu__lista {
    list-style: none;
    margin: 0 0 var(--space-3);
    /* Sangría y línea a la izquierda: sin una señal de jerarquía, los ocho tipos
       se leen como ocho entradas más del menú principal. */
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
  }
  .submenu__lista a {
    display: flex; align-items: center;
    min-height: 48px;
    font-family: var(--font-ui); font-size: var(--text-base);
    letter-spacing: 0.04em; text-transform: none;
    color: var(--color-ink-muted); text-decoration: none;
  }
  .submenu__lista a:hover,
  .submenu__lista a[aria-current='page'] { color: var(--color-accent-text); }
</style>
