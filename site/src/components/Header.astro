---
/**
 * Cabecera.
 *
 * Dos modos, controlados por `sobreHero`:
 *
 * - `true`  — se posa SOBRE la fotografía del héroe, transparente y en blanco.
 *             Es la composición de Cappa y lo que produce la primera impresión.
 * - `false` — sólida y pegada arriba, para las páginas sin héroe a sangre.
 *
 * Cappa cambia de transparente a sólida al hacer scroll con jQuery. Aquí no hay
 * JavaScript: sobre el héroe la cabecera acompaña al scroll y desaparece con él.
 * La alternativa —fija y translúcida— dejaría texto blanco sobre el contenido
 * claro de abajo, que es un fallo de contraste, no una decisión estética.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/logo-azucar.webp';
import { usarT, ruta, idiomas, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma; rutaActual?: string; sobreHero?: boolean }
const { idioma, rutaActual = '', sobreHero = false } = Astro.props;
const t = usarT(idioma);

// Sólo se enlaza lo que EXISTE. «Galería» vuelve al menú porque ya está
// construida (H4.4). «Restaurante» sigue fuera: está bloqueado por la pregunta
// C0 —el propio hotel dice en su FAQ que no tiene— y un menú que promete
// páginas inexistentes es la primera grieta de confianza.
const enlaces: { clave: string; path: string; submenu?: boolean }[] = [
  { clave: 'nav.alojamiento', path: 'alojamiento', submenu: true },
  { clave: 'nav.servicios',   path: 'servicios' },
  { clave: 'nav.galeria',     path: 'galeria' },
  { clave: 'nav.ubicacion',   path: 'ubicacion' },
  { clave: 'nav.faq',         path: 'preguntas-frecuentes' },
  { clave: 'nav.contacto',    path: 'contacto' },
];
/* El alias vive aquí y no en la plantilla: dentro del marcado, `<typeof t>` lo
   interpreta el compilador de Astro como una ETIQUETA y rompe el análisis. */
type ClaveUI = Parameters<typeof t>[0];
const otro: Idioma = idioma === 'es' ? 'en' : 'es';

/**
 * Submenú de «Alojamiento» — los ocho tipos reales.
 *
 * ── POR QUÉ ÉSTE Y NINGÚN OTRO ──────────────────────────────────────────────
 * Cappa tiene cuatro desplegables: «Home» con quince portadas alternativas,
 * «Rooms & Suites» con tres maquetas distintas de la misma página, «Pages» con
 * un cajón de sastre y «News» con tres formatos de blog. **Los cuatro son
 * andamiaje de demo**, no arquitectura de información: existen para enseñar
 * variantes al comprador de la plantilla.
 *
 * Copiarlos literalmente sería copiar el andamio. Lo que sí es real es el
 * MECANISMO —un desplegable en la navegación— y aquí hay exactamente un sitio
 * donde gana algo: los ocho tipos de alojamiento, que ya existen y que de otro
 * modo están a dos clics. Es lo que «Rooms & Suites» sería si la plantilla no
 * fuera una demo.
 */
const tipos = (await getCollection('alojamiento', (x) => x.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<header class:list={['cabecera', sobreHero && 'cabecera--sobre-hero']}>
  <div class="contenedor cabecera__fila">
    {/* El logotipo REAL del hotel, tomado de su sitio vigente
        (`logo_azucar_dorado-png.webp`, 310 × 193, con transparencia).

        Antes había un wordmark tipográfico —«Azúcar» en Gilda Display con
        «Hotel Tulum» debajo— que compuse para tener algo mientras. No era el
        logotipo del hotel: la cúpula dorada, la palabra manuscrita «Hotel» y
        las líneas turquesa son su identidad, y ninguna estaba ahí.

        `alt` con el nombre del hotel y no «logotipo»: quien no ve la imagen
        necesita saber a dónde lleva el enlace, no de qué tipo de gráfico se
        trata (WCAG 1.1.1). */}
    <a class="marca" href={ruta(idioma)}>
      <Image
        class="marca__logo"
        src={logo}
        alt="Azúcar Hotel Tulum"
        widths={[112, 224]}
        sizes="112px"
        loading="eager"
      />
    </a>

    {/* Navegación horizontal, sólo en escritorio. Es la pieza que más distingue
        visualmente a Cappa y la que faltaba: antes el escritorio sólo mostraba
        idioma y botón, lo que dejaba la cabecera vacía. */}
    {/* Los dos <nav> de la cabecera —el horizontal de escritorio y el del cajón
      móvil— llevaban la MISMA etiqueta, «Menú». Sólo uno se renderiza a la vez,
      así que en la práctica no molestaba a nadie; aun así, dos landmarks del
      mismo tipo con nombre idéntico son ambiguos por definición y no cuesta
      nada distinguirlos. Lo encontró `html-validate`; mi propio auditor pedía
      que las <nav> tuvieran nombre, no que fuera ÚNICO. */}
  <nav class="nav" aria-label={t('nav.principal')}>
      <ul class="nav__lista">
        {enlaces.map((e) => (
          <li>
            {e.submenu ? (
              /* <details> y no un <button> con JavaScript: el navegador ya
                 gestiona el estado, el teclado —Enter y Espacio— y anuncia
                 «contraído / expandido» al lector de pantalla sin sincronizar un
                 `aria-expanded` a mano. Cappa deja ese atributo fijo en «false»
                 y no lo actualiza nunca: quien use lector de pantalla oye
                 «contraído» también con el menú abierto. */
              <details class="desplegable">
                <summary class="desplegable__disparador">
                  <span>{t(e.clave as ClaveUI)}</span>
                  <span class="desplegable__flecha" aria-hidden="true"></span>
                </summary>
                <ul class="desplegable__panel">
                  <li>
                    <a
                      class="desplegable__todos"
                      href={ruta(idioma, e.path)}
                      aria-current={rutaActual === e.path ? 'page' : undefined}
                    >{t('nav.verTodo')}</a>
                  </li>
                  {tipos.map((x) => (
                    <li>
                      <a href={ruta(idioma, `alojamiento/${x.id}`)}>{x.data.nombre[idioma]}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={ruta(idioma, e.path)}
                aria-current={rutaActual === e.path ? 'page' : undefined}
              >{t(e.clave as ClaveUI)}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    {/* El <details> da un menú desplegable accesible sin una línea de JS: el
        navegador gestiona el estado, el teclado y el anuncio del estado
        expandido al lector de pantalla. Cappa usaba jQuery para esto.

        Este comentario usa la sintaxis de llaves y NO la de HTML: Astro
        descarta la primera al compilar y conserva la segunda. Éste era el único
        comentario HTML del proyecto y viajaba en las 38 páginas — 8.5 KB de
        notas internas enviadas a cada visitante. Nadie lo iba a ver salvo quien
        mirase el código fuente, que es justo el motivo de que llevara tanto
        tiempo ahí.

        Y cuidado al reescribir esta nota: una secuencia de cierre de comentario
        dentro del propio texto lo termina antes de tiempo y rompe el build.
        Pasó exactamente al escribirla. */}
    <details class="menu">
      <summary class="menu__boton" aria-label={t('nav.menu')}>
        <span aria-hidden="true" class="menu__icono"></span>
        <span class="sr-only">{t('nav.menu')}</span>
      </summary>
      <nav class="menu__panel" aria-label={t('nav.menu')}>
        <ul class="menu__lista">
          {enlaces.map((e) => (
            <li>
              {e.submenu ? (
                /* En el cajón el mismo submenú es un acordeón ANIDADO, no un
                   panel flotante: es lo que hace Cappa en móvil —su submenú pasa
                   a `position: static`— y es lo correcto, porque un panel
                   absoluto dentro de un cajón que ya scrollea se sale de la
                   pantalla. Aquí no hay hover: en una pantalla táctil no existe,
                   y dejarlo produce el «hover pegajoso» de la primera pulsación. */
                <details class="submenu">
                  <summary class="submenu__disparador">
                    <span>{t(e.clave as ClaveUI)}</span>
                    <span class="submenu__flecha" aria-hidden="true"></span>
                  </summary>
                  <ul class="submenu__lista">
                    <li>
                      <a
                        href={ruta(idioma, e.path)}
                        aria-current={rutaActual === e.path ? 'page' : undefined}
                      >{t('nav.verTodo')}</a>
                    </li>
                    {tipos.map((x) => (
                      <li><a href={ruta(idioma, `alojamiento/${x.id}`)}>{x.data.nombre[idioma]}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={ruta(idioma, e.path)}
                  aria-current={rutaActual === e.path ? 'page' : undefined}
                >{t(e.clave as ClaveUI)}</a>
              )}
            </li>
          ))}
        </ul>
        <div class="menu__pie">
          <a class="menu__idioma" href={ruta(otro, rutaActual)} lang={otro} hreflang={otro}>
            {idiomas[otro]}
          </a>
          <a class="boton boton--primario" href={ruta(idioma, 'reservar')}>{t('reserva.cta')}</a>
        </div>
      </nav>
    </details>

    <div class="cabecera__acciones">
      <a class="cabecera__idioma" href={ruta(otro, rutaActual)} lang={otro} hreflang={otro}>
        {idiomas[otro]}
      </a>
      <a class="boton boton--primario" href={ruta(idioma, 'reservar')}>{t('reserva.cta')}</a>
    </div>
  </div>
</header>

<script>
  /**
   * Cerrar el menú con `Esc` — WCAG 2.2 AA, criterio 1.4.13 «Content on Hover
   * or Focus», apartado *Dismissible*.
   *
   * ── POR QUÉ HACE FALTA JAVASCRIPT AQUÍ, CON LO CELOSOS QUE SOMOS ────────────
   * El desplegable se abre al pasar el ratón y tapa contenido de la página. El
   * criterio exige poder descartarlo **sin mover el puntero ni el foco**, y eso
   * es exactamente lo único que el CSS no puede hacer: un estado `:hover` sólo
   * se retira moviendo el ratón.
   *
   * Todo lo demás —abrir, cerrar, teclado, anuncio de contraído/expandido— lo
   * resuelve `<details>` sin una línea de código. Esto son 22 líneas para cubrir
   * el hueco, no un gestor de menús.
   *
   * De paso cierra el cajón móvil con `Esc`, que antes tampoco se cerraba, y
   * devuelve el foco a su disparador para no dejarlo en un elemento oculto.
   */
  const cabecera = document.querySelector('header.cabecera');
  if (cabecera) {
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      const abiertos = [...cabecera.querySelectorAll<HTMLDetailsElement>('details[open]')];
      if (!abiertos.length) return;
      // Del más interno al más externo: `Esc` cierra un nivel por pulsación, que
      // es lo que espera quien tiene un submenú abierto dentro del cajón.
      const objetivo = abiertos[abiertos.length - 1];
      objetivo.open = false;
      objetivo.querySelector<HTMLElement>('summary')?.focus();
    });

    // Un clic fuera cierra el desplegable de escritorio. Sin esto queda abierto
    // tras pulsarlo, porque `<details>` sólo se cierra con su propio disparador.
    document.addEventListener('click', (ev) => {
      for (const d of cabecera.querySelectorAll<HTMLDetailsElement>('.desplegable[open]')) {
        if (!d.contains(ev.target as Node)) d.open = false;
      }
    });
  }
</script>

<style>
  .cabecera {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  /* Sobre el héroe: sin fondo, sin borde y en blanco. `absolute` y no `sticky`
     para que se vaya con la foto en vez de quedarse flotando sobre el contenido. */
  .cabecera--sobre-hero {
    position: absolute; inset-inline: 0; top: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 0;
  }

  .cabecera__fila {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--alto-cabecera);
  }
  .marca { display: flex; align-items: center; text-decoration: none; }
  .marca__logo {
    /* 112 px de ancho: a 310 × 193 el logotipo queda en 70 px de alto, que cabe
       holgado en la fila de 88 px y deja el aire de la plantilla. Alto
       automático desde la proporción real, así no hay CLS. */
    width: 112px;
    height: auto;
  }
  .marca:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .nav { display: none; }
  .nav__lista {
    display: flex; align-items: center; gap: var(--space-5);
    list-style: none; padding: 0; margin: 0;
  }
  /* `> li > a`: SÓLO los enlaces de primer nivel.
     Escrito como `.nav__lista a` alcanzaba también los del panel desplegable, y
     sobre el héroe —donde estos van en blanco— el panel quedaba con nueve
     enlaces blancos sobre fondo blanco. No lo vio ninguna medición: el panel
     estaba ahí, con su altura y sus 44 px por enlace, y `getComputedStyle`
     decía «blanco» sin que nada dijera que debajo también era blanco. Lo enseñó
     una captura de pantalla. */
  .nav__lista > li > a {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .nav__lista > li > a:hover,
  .nav__lista > li > a[aria-current='page'] {
    color: var(--color-accent-text);
    border-bottom-color: var(--color-accent);
  }

  .cabecera__acciones { display: none; align-items: center; gap: var(--space-4); }
  /* El botón de la cabecera NUNCA se parte en dos líneas.
     Al subir la separación de letras del selector de idioma de 0.12em a 0.20em
     —para igualar la navegación de Cappa— la fila creció ocho píxeles y eso
     bastó para que «Solicitar reserva» pasara a dos renglones. Ocho píxeles.
     La cabecera iba al límite y nadie lo sabía porque nunca se había medido. */
  .cabecera__acciones .boton { white-space: nowrap; }
  /* `inline-flex` y no el `inline` por defecto: en un <a> inline el padding
     vertical NO cuenta para la altura de la caja, así que el enlace medía 23 px
     y no llegaba al mínimo de 24 px de WCAG 2.2 AA 2.5.8. Es el mismo defecto
     que ya apareció en el pie, y sigue siendo invisible a ojo. */
  .cabecera__idioma {
    display: inline-flex; align-items: center;
    min-height: 44px;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-nav); text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
    padding-inline: var(--space-2);
  }
  .cabecera__idioma:hover { color: var(--color-accent-text); }

  /* --- Variante sobre fotografía -------------------------------------------
     Todo lo que va sobre la foto pasa a blanco puro. Sobre el velo del héroe
     (0.3 plano + degradado) el blanco da 7:1 largo, muy por encima del 4.5:1. */
  /* ⚠️ MARGEN MEDIDO, Y ES ESTRECHO.
     Sobre el héroe estos textos son blancos y su legibilidad depende de la
     FOTOGRAFÍA que haya debajo, no de un color. Medido sobre los píxeles reales
     de `hero-roof-top.webp`, componiendo el degradado de `.hero__velo`
     (34 % de negro arriba, 6 % al 20 % del alto), en 18 muestras por elemento:

         escritorio 1280 px   logo 5.30:1 · subtítulo 4.93:1 · nav 4.93:1
         móvil       320 px   logo 9.42:1 · subtítulo 9.60:1

     El mínimo AA para texto pequeño es 4.5:1. En escritorio quedan **4.93:1**:
     pasa, con un 10 % de margen. Es el punto más ajustado del sitio.

     🔴 Si se cambia la fotografía del héroe por una más clara en su franja
     superior, esto DEJA DE CUMPLIR y no lo detecta ningún auditor de marcado.
     Hay que volver a medir. La alternativa estructural sería añadir un velo
     propio a la cabecera, a costa de la composición de Cappa. */
  .cabecera--sobre-hero .nav__lista > li > a,
  .cabecera--sobre-hero .cabecera__idioma { color: #fff; }

  /* Sobre la fotografía del héroe el logotipo se pinta en BLANCO SÓLIDO.
     El del hotel es dorado sobre marrón oscuro y sólo existe esa versión —se
     buscó en toda la captura del sitio vigente—, porque su cabecera es blanca y
     nunca necesitaron otra. Sobre una foto oscura, los marrones desaparecen.

     `brightness(0)` lo aplasta a negro puro y `invert(1)` lo pasa a blanco: se
     conserva la SILUETA, que es lo que hace reconocible una marca, y se pierde
     el color, que aquí no se podía leer de todos modos.

     Lo correcto sería una versión clara del logotipo. Es un archivo, no código:
     queda anotado para pedírselo al hotel. */
  .cabecera--sobre-hero .marca__logo { filter: brightness(0) invert(1); }
  .cabecera--sobre-hero .nav__lista > li > a:hover,
  .cabecera--sobre-hero .nav__lista > li > a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--color-accent);
  }
  .cabecera--sobre-hero .menu__icono,
  .cabecera--sobre-hero .menu__icono::before,
  .cabecera--sobre-hero .menu__icono::after { background: #fff; }
  .cabecera--sobre-hero .menu[open] .menu__icono { background: transparent; }

  .menu__boton {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;      /* objetivo táctil accesible */
    cursor: pointer; list-style: none;
  }
  .menu__boton::-webkit-details-marker { display: none; }
  .menu__icono, .menu__icono::before, .menu__icono::after {
    display: block; width: 22px; height: 1.5px; background: var(--color-ink);
    transition: transform var(--dur) var(--ease);
  }
  .menu__icono::before, .menu__icono::after { content: ''; position: relative; }
  .menu__icono::before { top: -7px; }
  .menu__icono::after  { top: 5.5px; }
  .menu[open] .menu__icono { background: transparent; }
  .menu[open] .menu__icono::before { transform: translateY(7px) rotate(45deg); }
  .menu[open] .menu__icono::after  { transform: translateY(-5.5px) rotate(-45deg); }

  .menu__panel {
    position: absolute; left: 0; right: 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-5) var(--gutter) var(--space-6);
  }
  .menu__lista { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  .menu__lista a {
    display: block; padding: var(--space-3) 0;
    font-family: var(--font-ui); font-size: var(--text-lg);
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
  }
  .menu__lista a:hover, .menu__lista a[aria-current='page'] { color: var(--color-accent-text); }
  .menu__pie {
    display: flex; align-items: center; gap: var(--space-4);
    margin-top: var(--space-5); padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .menu__idioma {
    display: inline-flex; align-items: center;
    min-height: 44px;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-nav); text-transform: uppercase;
    color: var(--color-ink); text-decoration: none;
  }

  /* El umbral sube a 68rem porque ahora hay seis apartados en horizontal más
     el idioma y el botón: por debajo de eso no caben sin apretarse. */
  @media (min-width: 68rem) {
    .menu { display: none; }
    .nav { display: block; }
    .cabecera__acciones { display: flex; }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     DESPLEGABLE DE ESCRITORIO — patrón `.dropdown` de Cappa

     Medido sobre `demo1-light/index11.html`: panel blanco de 190 px, `padding:
     15px`, `box-shadow: 0 16px 50px rgb(0 0 0 / .07)`, sin borde, revelado con
     `opacity` y `visibility` (no con `display`, para que pueda animarse).

     ── POR QUÉ `<details>` Y NO UN `<button>` CON JAVASCRIPT ────────────────
     El navegador ya gestiona el estado, el teclado —Enter y Espacio— y anuncia
     «contraído / expandido» sin sincronizar nada a mano. Cappa deja
     `aria-expanded="false"` fijo en el disparador y nunca lo actualiza: quien
     use lector de pantalla oye «contraído» también con el menú abierto.

     El truco que lo hace posible: un `<details>` cerrado oculta su contenido
     con la hoja del navegador, y `display: block` lo anula. Comprobado en el
     motor antes de construirlo. Así el panel puede existir siempre y sólo
     cambiar de opacidad. */
  .desplegable { position: relative; }

  .desplegable__disparador {
    display: inline-flex; align-items: center; gap: var(--space-2);
    cursor: pointer; list-style: none;
    /* la altura mínima es del enlace de al lado; ver `.nav__lista a` */
  }
  .desplegable__disparador::-webkit-details-marker { display: none; }
  .desplegable__flecha {
    width: 0; height: 0;
    border-inline: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    transition: rotate var(--dur) var(--ease);
  }

  .desplegable__panel {
    position: absolute; top: 100%; left: 0; z-index: 60;
    min-width: 15rem;
    list-style: none; margin: 0;
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: 0 16px 50px rgb(0 0 0 / 0.07);
    /* Sin `display: none`: se oculta con visibilidad para poder animarlo, y
       `visibility: hidden` —a diferencia de `opacity: 0` sola— lo saca del
       recorrido de tabulación, que es lo que impide tabular a enlaces que no
       se ven. */
    opacity: 0; visibility: hidden;
    translate: 0 6px;
    transition: opacity var(--dur) var(--ease), visibility var(--dur), translate var(--dur) var(--ease);
  }
  /* Anula el ocultado que aplica el navegador a un <details> cerrado. */
  .desplegable:not([open]) > .desplegable__panel { display: block; }

  .desplegable__panel a {
    display: block;
    min-height: 44px;            /* objetivo táctil, WCAG 2.5.8 */
    padding: var(--space-2) var(--space-3);
    line-height: 1.5;
    display: flex; align-items: center;
    font-family: var(--font-ui); font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink); text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .desplegable__panel a:hover,
