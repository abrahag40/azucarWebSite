---
import { usarT, ruta, type Idioma } from '../i18n/ui';
import { contacto, presentacion } from '../data/hotel';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);
const anio = new Date().getFullYear();

/**
 * Pie de tres columnas — patrón `footer` de Cappa, medido en el sitio en vivo:
 * «About Hotel» con un párrafo, «Explore» con seis enlaces de navegación,
 * «Contact» con dirección, teléfono y correo, y una barra de copyright debajo.
 *
 * ── QUÉ FALTABA, Y NO ERA ESTÉTICO ──────────────────────────────────────────
 * El pie tenía **tres enlaces** —los legales— frente a los doce de Cappa. Es
 * decir: quien llegaba al final de cualquiera de las 38 páginas no tenía a
 * dónde ir salvo volver arriba. Un pie sin navegación desperdicia el único
 * momento en que el visitante ya leyó todo y sigue interesado, y además deja al
 * sitio sin la red de enlaces internos que Google usa para entender su
 * estructura.
 *
 * Todo el contenido nuevo ya existía: los enlaces son los del menú, y el texto
 * es la primera frase de la presentación, que es literal del hotel.
 */
/* El pie es donde siguen viviendo «Cómo llegar» y «Contacto».
   La barra de arriba se reordenó a petición del cliente (2026-09-01) y esos dos
   apartados se quedaron fuera de ella: siete entradas ya no dejan sitio para
   nueve. Que salgan del menú principal no puede significar que desaparezcan —
   son las dos páginas que busca quien ya decidió venir. */
const explorar = [
  { clave: 'nav.nosotros', path: 'nosotros' },
  { clave: 'nav.alojamiento', path: 'alojamiento' },
  { clave: 'nav.amenidades', path: 'servicios' },
  { clave: 'nav.restaurante', path: 'restaurante' },
  /* Galería antes que Eventos — orden pedido por el cliente el 2026-09-03. */
  { clave: 'nav.galeria', path: 'galeria' },
  { clave: 'nav.eventos', path: 'eventos' },
  { clave: 'nav.actividades', path: 'actividades' },
  { clave: 'nav.ubicacion', path: 'ubicacion' },
  { clave: 'nav.faq', path: 'preguntas-frecuentes' },
  { clave: 'nav.contacto', path: 'contacto' },
] as const;

/* Las DOS primeras frases de la presentación, no una.
   Eran una sola hasta el 2026-09-03. El cliente reescribió la apertura del
   párrafo y su texto son dos frases —«…se hizo realidad en 2008. Desde
   entonces, un equipo comprometido…»—: cortando por el primer punto, el pie
   se quedaba con la mitad y perdía justo lo que el cliente quería decir.
   El resto del párrafo —los premios— sigue sólo en la portada. */
const resumen = presentacion.parrafos[0][idioma].split('. ').slice(0, 2).join('. ') + '.';
const soloDigitos = (n: string) => n.replace(/[^+\d]/g, '');

---
<footer class="pie">
  <div class="contenedor pie__rejilla">
    <div class="pie__col">
      <p class="pie__marca">Azucar Hotel Tulum</p>
      <p class="pie__resumen">{resumen}</p>
    </div>

    <nav class="pie__col" aria-label={t('footer.explorar')}>
      <h2 class="pie__titulo">{t('footer.explorar')}</h2>
      <ul class="pie__lista">
        {explorar.map((e) => (
          <li><a href={ruta(idioma, e.path)}>{t(e.clave)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="pie__col">
      {/* DOS rótulos donde antes había uno (cliente, 2026-09-03): la dirección
          y las formas de contacto son dos cosas distintas y la columna las
          daba por lo mismo. Los dos son <h2> reales y no párrafos con
          aspecto de título: el índice de encabezados es cómo se recorre una
          página con lector de pantalla (WCAG 2.4.6). */}
      <h2 class="pie__titulo">{t('footer.direccionTitulo')}</h2>
      <address class="pie__direccion">{t('footer.direccionCalle')}<br />{t('footer.direccionCp')}</address>
      <h2 class="pie__titulo pie__titulo--sep">{t('footer.contacto')}</h2>
      <ul class="pie__lista">
        {contacto.telefonos.map((n) => (
          <li><a class="telefono" href={`tel:${soloDigitos(n)}`}>{n}</a></li>
        ))}
        <li><a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></li>
      </ul>
    </div>
  </div>

  <div class="contenedor pie__legal">
    <p>© {anio} Azucar Hotel Tulum. {t('footer.derechos')}</p>
    {/* «Términos y condiciones» sigue FUERA: no existe ni en el sitio vigente
        —lo inventamos nosotros al maquetar el pie— y no hay texto que publicar.
        Vuelve cuando exista, no antes. */}
    <nav class="pie__nav" aria-label={t('footer.legalTitulo')}>
      <ul>
        <li><a href={ruta(idioma, 'politicas')}>{t('footer.politicas')}</a></li>
        <li><a href={ruta(idioma, 'aviso-de-privacidad')}>{t('footer.privacidad')}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .pie {
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8) var(--space-5);
    /* SIN `margin-top`.
       Tenía 4 rem, pensados para separarlo de una sección de fondo blanco. Pero
       cuando la sección anterior es cálida —como pasa en la portada— ese margen
       deja una banda blanca de 64 px entre dos fondos de color, y se ve como un
       error de maquetación. Lo era. El pie ya se distingue por su fondo y su
       borde superior; el espacio lo aporta su `padding-block`. */
  }

  /* Una columna en móvil, tres a partir de 48 rem. El reparto 1.4 / 1 / 1.2 da
     más aire a la columna del texto y a la de contacto, que llevan frases, y
     menos a la lista de enlaces, que son palabras sueltas. Cappa usa 4/3/4 de
     doce, que es la misma idea. */
  .pie__rejilla {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: var(--space-7);
  }
  @media (min-width: 48rem) {
    .pie__rejilla { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-6); }
  }
  .pie__col { min-width: 0; }

  .pie__marca {
    font-family: var(--font-display); font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .pie__resumen {
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    max-width: 42ch;
    margin: 0;
  }

  .pie__titulo--sep { margin-top: var(--space-5); }
  .pie__titulo {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-antetitulo);
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }

  .pie__direccion {
    font-style: normal;
    color: var(--color-ink-muted);
    max-width: 32ch;
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3);
  }

  .pie__lista { list-style: none; padding: 0; margin: 0; }
  /* `block` con altura mínima: un <a> en línea NO suma su relleno vertical a la
     caja y se queda en 19 px, por debajo de los 24 de WCAG 2.5.8. Es el defecto
     que más veces ha aparecido en este proyecto; por eso el auditor ya avisa
     del patrón «enlace solo en su párrafo». */
  .pie__lista a,
  .pie__nav a {
    display: block;
    min-height: 32px;
    line-height: 32px;
    font-family: var(--font-ui);
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .pie__lista a:hover,
  .pie__nav a:hover,
  .pie__lista a[aria-current='page'] { color: var(--color-accent-text); }

  /* Barra inferior: copyright a la izquierda, legales a la derecha. */
  .pie__legal {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .pie__legal p { margin: 0; }
  @media (min-width: 48rem) {
    .pie__legal { grid-template-columns: 1fr auto; align-items: center; }
  }
  .pie__nav ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: var(--space-5);
  }
  .pie__nav a { font-size: var(--text-sm); }
</style>
