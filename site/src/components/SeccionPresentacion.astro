---
/**
 * Sección de presentación — equivale a `about` de Cappa `index11`.
 *
 * Composición de la plantilla: a la izquierda antetítulo, título, dos párrafos y
 * un bloque de contacto; a la derecha un par de fotografías desfasadas en
 * vertical. Se conserva tal cual.
 *
 * Lo que NO se copia: Cappa abre la sección con cinco estrellas doradas. Son una
 * categoría hotelera y no tenemos ninguna confirmada por el cliente. Publicar
 * cinco estrellas porque la plantilla las trae sería inventar una clasificación
 * —regla 7—. El texto sí dice, porque es cierto y está publicado, que el hotel
 * ha ganado premios y es un Small Luxury Hotel.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { usarT, idAncla, type Idioma } from '../i18n/ui';
import { presentacion, contacto } from '../data/hotel';
import foto1 from '../assets/nosotros-1.webp';
import foto2 from '../assets/nosotros-2.webp';

/**
 * Las fotografías son un PROP, y ése es el punto.
 *
 * Este componente lo usan dos páginas: la portada y `/nosotros/`. El cliente
 * mandó el 2026-09-10 una carpeta llamada `home/` —tres detalles de la casa: el
 * pozo de piedra, el andador de madera entre la vegetación y las dos sillas de
 * mimbre en el entarimado— **para la portada**. Cambiar los imports habría
 * puesto esas tres también en `/nosotros/`, que no era lo pedido.
 *
 * Con un prop, la portada pasa las suyas y `/nosotros/` se queda con las que
 * tenía. Es la misma lección que `sobreHero`: cuando un componente vive en dos
 * sitios, lo que cambia entre ellos se parametriza, no se edita.
 *
 * Van SIN `alt`, como iban las anteriores: acompañan a un texto que ya dice lo
 * que ellas enseñan, así que describirlas obligaría a un lector de pantalla a
 * oír dos veces lo mismo (WCAG 1.1.1, imagen decorativa).
 */
interface Props {
  idioma: Idioma;
  fotos?: ImageMetadata[];
}
const { idioma, fotos = [foto1, foto2] } = Astro.props;
const t = usarT(idioma);
---
<section id={idAncla(idioma, 'elHotel')} class="seccion presentacion" aria-labelledby="presentacion-titulo">
  <div class="contenedor presentacion__rejilla">
    <div class="presentacion__texto" data-revelar>
      <p class="antetitulo">{presentacion.antetitulo[idioma]}</p>
      <h2 id="presentacion-titulo">{presentacion.titulo[idioma]}</h2>
      {presentacion.parrafos.map((p) => <p class="presentacion__parrafo">{p[idioma]}</p>)}

      <div class="presentacion__contacto">
        <p class="presentacion__etiqueta">{t('reserva.cta')}</p>
        <a class="presentacion__tel" href={`tel:${contacto.telefonos[0].replace(/[^+\d]/g, '')}`}>
          {contacto.telefonos[0]}
        </a>
      </div>
    </div>

    <div class={`presentacion__fotos presentacion__fotos--${fotos.length}`} data-revelar>
      {/* Con TRES, las dos de la derecha van dentro de una columna propia. No es
          adorno de marcado: es lo que hace que el bloque cuadre solo. La rejilla
          queda con UNA fila, la vertical de la izquierda le fija el alto con su
          proporción, y la columna se estira hasta ese alto y lo reparte entre
          sus dos hijas. Con `grid-template-rows: 1fr 1fr` y las tres sueltas el
          alto era circular —lo medí: 325 px de foto alta contra 421 de
          contenedor, y los bordes de arriba sin alinear. */}
      <Image
        class="presentacion__foto presentacion__foto--alta"
        src={fotos[0]}
        alt=""
        widths={[280, 420]}
        sizes="(min-width: 60rem) 20rem, 42vw"
        loading="lazy"
        quality={50}
      />
      {fotos.length === 3 ? (
        <div class="presentacion__columna">
          {fotos.slice(1).map((f) => (
            <Image class="presentacion__foto" src={f} alt=""
              widths={[280, 420]} sizes="(min-width: 60rem) 20rem, 42vw" loading="lazy" quality={50} />
          ))}
        </div>
      ) : (
        fotos.slice(1).map((f) => (
          <Image class="presentacion__foto" src={f} alt=""
            widths={[280, 420]} sizes="(min-width: 60rem) 20rem, 42vw" loading="lazy" quality={50} />
        ))
      )}
    </div>
  </div>
</section>

<style>
  /* Destino de la flecha del héroe. `scroll-margin-top: 0` ANULA el
     `scroll-padding-top` global: ese desplazamiento existe para que la cabecera
     pegajosa no tape el destino, y en la portada la cabecera es `absolute` —se
     va con el héroe— así que aquí no tapa nada. Sin esto la flecha se quedaría
     104 px corta y dejaría una franja del héroe arriba, que se lee como un
     salto a medias. */
  /* 🔴 SÓLO CUANDO VIENE DETRÁS DEL HÉROE — `:global(.hero) + &`.
     Este margen negativo ANULA el `scroll-padding-top` global, y sólo tiene
     sentido en la portada: allí la cabecera es `absolute` y se va con la foto,
     así que no tapa nada y reservarle 120 px deja una franja del héroe arriba,
     que se lee como un salto a medias.

     En `/nosotros/`, que reutiliza este mismo componente desde el 2026-09-01,
     la cabecera SÍ es pegajosa. Sin esta condición, saltar a `#el-hotel` allí
     aterrizaría 120 px demasiado alto y el título quedaría debajo de la
     cabecera. Es el precio de reutilizar un componente escrito para un solo
     sitio: la regla que lo acompaña también tiene que saber dónde está. */
  :global(.hero) + .presentacion { scroll-margin-top: calc(-1 * var(--desplazamiento-ancla)); }

  .presentacion__rejilla {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .presentacion__texto { max-width: var(--container-text); }
  .presentacion__texto h2 {
    font-size: var(--text-3xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .presentacion__parrafo {
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    margin-bottom: var(--space-4);
  }
  .presentacion__contacto {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .presentacion__etiqueta {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-antetitulo);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .presentacion__tel {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .presentacion__tel:hover { text-decoration: underline; }

  .presentacion__fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  /* Con TRES fotos la rejilla de dos columnas dejaría la tercera sola en una
     fila, descolgada. La primera pasa a ocupar las dos filas de la izquierda y
     las otras dos se apilan a su derecha: la composición clásica de tres, y la
     que aprovecha que la primera de la portada es vertical y las otras dos
     apaisadas. No hace falta tocar nada para volver a dos. */
  /* `stretch` y no el `start` heredado: la columna de la derecha tiene que
     llegar exactamente hasta donde llega la vertical de la izquierda. */
  .presentacion__fotos--3 { align-items: stretch; }
  .presentacion__columna {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 0;
  }
  /* `min-height: 0` en las dos: sin él, el mínimo automático de un ítem flex es
     su contenido y las fotos se negarían a encoger, desbordando la columna. */
  .presentacion__columna .presentacion__foto {
    flex: 1;
    min-height: 0;
    height: auto;
    aspect-ratio: auto;
  }
  .presentacion__foto {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }
  /* El desfase vertical del par es lo que da el ritmo de Cappa. Se aplica sólo
     donde hay sitio: en móvil las dos fotos van a la misma altura. */
  @media (min-width: 48rem) {
    .presentacion__foto--alta { margin-top: var(--space-9); }
  }
  @media (min-width: 60rem) {
    .presentacion__rejilla { grid-template-columns: 1fr 1fr; gap: var(--space-9); }
  }
</style>
