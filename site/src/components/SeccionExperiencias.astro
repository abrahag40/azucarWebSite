---
/**
 * Tres experiencias con fotografía grande — patrón `services` de Cappa.
 *
 * ── DE DÓNDE SALE ───────────────────────────────────────────────────────────
 * De la sección `services` de `index11.html`: tres tarjetas con fotografía a
 * sangre, un antetítulo corto encima del título, un párrafo y un enlace. En
 * Cappa son Restaurant, Spa Center y Fitness Center.
 *
 * ── POR QUÉ NO SON ESAS TRES ────────────────────────────────────────────────
 * Ninguna de las tres existe en este hotel. El restaurante y el spa están
 * bloqueados por la pregunta **C0** —su propio sitio se contradice— y gimnasio
 * no hay. Copiar los títulos de la plantilla habría sido prometer tres
 * servicios inventados en la portada.
 *
 * Se usa el mismo patrón con las tres cosas que el hotel SÍ tiene y que además
 * son su argumento real: la playa privada, la alberca infinita y el jacuzzi del
 * roof top. El texto sale de `data/hotel.ts`, que es literal de su propio sitio,
 * y las fotografías son de las ocho curadas en H4.4.
 */
import { Image } from 'astro:assets';
import { amenidades } from '../data/hotel';
import { usarT, ruta, type Idioma } from '../i18n/ui';
/**
 * ⚠️ NOTA PARA ABRAHAM — la fotografía de la alberca es la más floja de las tres.
 *
 * De las ocho fotografías curadas en H4.4, **ninguna tiene la alberca infinita
 * como sujeto**: la única que la menciona siquiera es la de la terraza con
 * hamaca, donde el agua se ve al fondo. Se revisó además todo el material
 * apaisado del archivo del hotel —244 imágenes— y las que hay son interiores y
 * terrazas.
 *
 * Se usa la mejor disponible en vez de forzar otra que no encaje, y queda
 * escrito aquí porque **no se arregla con código**: hace falta una fotografía de
 * la alberca. Es el mismo asterisco del informe de fidelidad
 * (`docs/04-diseno/fidelidad-a-cappa.md`, §5).
 */
import playa from '../assets/galeria/02-playa-arco.webp';
import alberca from '../assets/galeria/03-terraza-hamaca.webp';
import jacuzzi from '../assets/galeria/04-jacuzzi-roof-top.webp';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);

// Las tres primeras amenidades del hotel son exactamente estas tres. Se toman
// por su clave de icono y no por posición, para que reordenar `hotel.ts` no
// rompa esto en silencio.
const porIcono = (n: string) => amenidades.find((a) => a.icono === n);
const tarjetas = [
  { dato: porIcono('ola'),      imagen: playa,   etiqueta: t('exp.playaEtiqueta') },
  { dato: porIcono('alberca'),  imagen: alberca, etiqueta: t('exp.albercaEtiqueta') },
  { dato: porIcono('jacuzzi'),  imagen: jacuzzi, etiqueta: t('exp.jacuzziEtiqueta') },
].filter((x) => x.dato);
---
{tarjetas.length > 0 && (
  <section class="experiencias" aria-labelledby="exp-titulo">
    <div class="contenedor">
      <header class="encabezado encabezado--centrado">
        <p class="antetitulo">{t('exp.antetitulo')}</p>
        <h2 id="exp-titulo">{t('exp.titulo')}</h2>
      </header>
    </div>

    {/* Cada experiencia es una FILA a media pantalla: fotografía en un lado,
        texto sobre fondo cálido en el otro, alternando el lado en cada fila.
        Es el reparto exacto de la sección `services` de Cappa —cuatro filas de
        380 px, imagen izquierda, derecha, izquierda, derecha— y es lo que le da
        a esa sección su peso: en tres columnas, lo mismo ocupa la mitad y se lee
        como un pie de foto. */}
    <ul class="experiencias__filas" role="list">
      {tarjetas.map(({ dato, imagen, etiqueta }, i) => (
        <li class:list={['exp-fila', i % 2 === 1 && 'exp-fila--invertida']}>
          <div class="exp-fila__medio">
            <Image
              src={imagen}
              alt=""
              widths={[640, 960, 1280]}
              sizes="(min-width: 56rem) 50vw, 100vw"
              loading="lazy"
              quality={50}
            />
          </div>
          <div class="exp-fila__cuerpo">
            <div class="exp-fila__texto">
              <p class="antetitulo">{etiqueta}</p>
              <h3 class="exp-fila__titulo">{dato!.titulo[idioma]}</h3>
              <p class="exp-fila__parrafo">{dato!.texto[idioma]}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="contenedor">
      <p class="experiencias__accion">
        <a class="boton boton--secundario" href={ruta(idioma, 'servicios')}>{t('exp.ver')}</a>
      </p>
    </div>
  </section>
)}

<style>
  .experiencias { padding-block: clamp(var(--space-7), 8vw, var(--space-9)); }

  .experiencias__filas { list-style: none; padding: 0; margin: var(--space-7) 0 0; }

  /* A partir de 56 rem, dos mitades exactas. Por debajo, la foto arriba y el
     texto debajo: partir 380 px en dos columnas a 320 px deja ambas ilegibles. */
  .exp-fila { display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) {
    .exp-fila { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 380px; }
    /* La inversión se hace con `order` y sólo aquí: en móvil el orden del
       marcado —foto, luego texto— ya es el correcto y reordenar separaría el
       orden visual del orden de lectura. */
    .exp-fila--invertida .exp-fila__medio { order: 2; }
  }

  .exp-fila__medio { position: relative; min-height: 260px; background: var(--color-surface-alt); }
  .exp-fila__medio :global(img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }

  .exp-fila__cuerpo {
    display: grid; align-items: center;
    background: var(--color-surface-warm);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
  }
  .exp-fila__texto { max-width: 34rem; }
  .exp-fila__titulo {
    font-size: clamp(var(--text-xl), 2.4vw, var(--text-2xl));
    margin-block: var(--space-2) var(--space-4);
  }
  .exp-fila__parrafo {
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    margin: 0;
  }

  .experiencias__accion { margin: var(--space-7) 0 0; text-align: center; }
</style>
