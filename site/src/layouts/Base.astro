---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroPorDefecto from '../assets/hero-roof-top.webp';
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Analitica from '../components/Analitica.astro';
import { usarT, ruta, ancla, idAncla, type Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion: string;
  idioma: Idioma;
  /** Ruta sin prefijo de idioma, p. ej. 'alojamiento'. Vacía = portada. */
  rutaActual?: string;
  /** La cabecera se posa sobre la fotografía del héroe. Ver Header.astro. */
  sobreHero?: boolean;
  /**
   * Falso sólo para páginas que no representan contenido real —hoy, el 404—.
   * Emite `noindex` y omite canonical, hreflang y datos estructurados: una
   * página de error no tiene URL canónica ni es un Hotel, y declararlo manda
   * a Google señales contradictorias.
   */
  indexable?: boolean;
  /**
   * Imagen para la previsualización al compartir el enlace. Por defecto, la
   * fotografía del héroe.
   *
   * NO es un adorno: hasta ahora **ninguna** página declaraba `og:image`, así
   * que cada vez que alguien pegaba un enlace del hotel en WhatsApp, iMessage o
   * Facebook salía una tarjeta de texto sin foto. Para un hotel frente al mar,
   * la fotografía ES el argumento; una tarjeta sin imagen ocupa la mitad de
   * espacio en el chat y se ignora. Es de las pocas cosas de esta lista con
   * efecto comercial medible.
   */
  imagenSocial?: ImageMetadata;
}
const { titulo, descripcion, idioma, rutaActual = '', indexable = true, sobreHero = false,
        imagenSocial } = Astro.props;

/**
 * Derivada de 1200×630 para la tarjeta social.
 *
 * Ese tamaño no es capricho: es el que documentan Facebook y X para la tarjeta
 * grande, y con otra proporción los servicios recortan por su cuenta y sin
 * criterio. `fit: 'cover'` recorta de 4:3 a 1.91:1 desde el centro.
 *
 * La URL tiene que ser **absoluta**: los rastreadores de redes sociales no
 * resuelven rutas relativas, y una `/imagen.webp` a secas se descarta en
 * silencio — el fallo más habitual de este metadato, y no da ningún error.
 *
 * Formato JPEG y no WebP: WhatsApp y varios clientes de correo siguen sin
 * previsualizar WebP en 2026. Aquí no se optimiza el peso, se optimiza que la
 * imagen aparezca.
 */
/**
 * 🔴 La imagen sólo se usa si el ORIGINAL tiene al menos 1200 px de ancho.
 *
 * Sharp no amplía por encima del original. Se probó pasar la foto de cada tipo
 * de alojamiento —530 × 700 px— y el archivo salió de **529 × 630**, mientras el
 * metadato seguía declarando `og:image:width = 1200`. Dos fallos de un tiro:
 *   · El metadato mentía, y un rastreador que compara acaba descartando la imagen.
 *   · Facebook no monta la tarjeta grande por debajo de 600 px de ancho: habría
 *     salido la miniatura pequeña, justo lo que se quería evitar.
 *
 * Las fotos de habitación del hotel son todas verticales y pequeñas, así que
 * ninguna sirve. Se usa el héroe —1600 × 1200— en todas las páginas: la misma
 * imagen con títulos distintos es mucho mejor tarjeta que una imagen recortada
 * a una franja o rechazada por pequeña.
 *
 * Si algún día llegan fotografías grandes y apaisadas, basta pasarlas por
 * `imagenSocial` y este guardián las dejará pasar solo.
 */
const ANCHO_SOCIAL = 1200;
const ALTO_SOCIAL = 630;
const fuenteSocial =
  imagenSocial && imagenSocial.width >= ANCHO_SOCIAL ? imagenSocial : heroPorDefecto;
const social = await getImage({
  src: fuenteSocial,
  width: ANCHO_SOCIAL,
  height: ALTO_SOCIAL,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 72,
});
const urlSocial = new URL(social.src, Astro.site).href;
const t = usarT(idioma);

const canonical = new URL(ruta(idioma, rutaActual), Astro.site).toString();
const alternos = [
  { hreflang: 'es', href: new URL(ruta('es', rutaActual), Astro.site).toString() },
  { hreflang: 'en', href: new URL(ruta('en', rutaActual), Astro.site).toString() },
  { hreflang: 'x-default', href: new URL(ruta('es', rutaActual), Astro.site).toString() },
];

// schema.org/Hotel — el hueco competitivo detectado en la auditoría: ni el sitio
// actual ni la propuesta de ResNexus lo tienen. Sin esto Google no puede mostrar
// ubicación ni categoría en resultados.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: 'Azucar Hotel Tulum',
  url: Astro.site?.toString(),
  description: descripcion,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Carretera a Boca Paila km 7.5, Zona Hotelera',
    addressLocality: 'Tulum',
    addressRegion: 'Quintana Roo',
    // 77780, confirmado por el cliente el 2026-09-01. Faltaba: un
    // `PostalAddress` sin `postalCode` es una dirección incompleta para Google,
    // y el NAP —nombre, dirección, teléfono— es lo que coteja contra Business
    // Profile para el posicionamiento local.
    postalCode: '77780',
    addressCountry: 'MX',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 20.1489, longitude: -87.4483 },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Beachfront', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Outdoor pool', value: true },
    // `Restaurant` vuelve. Se retiró mientras duró la contradicción C0 —el FAQ
    // del hotel decía que no había—; Abraham la resolvió como Proxy PO el
    // 2026-08-25. Esto es una afirmación a Google en las 38 páginas, así que
    // depende de que el dato sea cierto: ver `src/data/restaurante.ts`.
    { '@type': 'LocationFeatureSpecification', name: 'Restaurant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free Wi-Fi', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking', value: true },
  ],
  // No se declara priceRange ni AggregateRating: no tenemos el dato confirmado
  // y schema.org inventado es peor que schema.org ausente.
};
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonical} />
        {alternos.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        <meta property="og:url" content={canonical} />
      </>
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content={idioma === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:site_name" content="Azucar Hotel Tulum" />
    <meta property="og:image" content={urlSocial} />
    <meta property="og:image:width" content={String(ANCHO_SOCIAL)} />
    <meta property="og:image:height" content={String(ALTO_SOCIAL)} />
    <meta property="og:image:alt" content={titulo} />
    {/* Sin `twitter:card` la tarjeta sale pequeña y con la foto en miniatura. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/* ── Iconos ──────────────────────────────────────────────────────────
        Sin esto el navegador pide `/favicon.ico` por su cuenta, recibe un 404 y
        lo anota como ERROR EN CONSOLA. Lo cazó Lighthouse, y ningún auditor de
        marcado podía verlo: el fallo no está en el HTML sino en una petición
        que el navegador hace sin que nadie se la escriba.

        El icono es el del propio hotel, tomado de su sitio vigente y convertido
        de WebP a PNG — WebP como favicon no lo admiten todos los navegadores. */}
    <link rel="icon" href="/iconos/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/iconos/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" />

    {/* Tipografías autoalojadas — ver src/styles/fuentes.css. Ya no hay
        `preconnect` ni hoja de estilo de terceros: las declaraciones viajan en
        el CSS del sitio y los archivos salen del mismo origen.

        `preload` SÓLO de la display, la del <h1>: se pide en paralelo con el CSS
        en vez de esperar a que el CSS se analice para descubrirla. Precargar las
        cinco sería contraproducente: competirían con la fotografía del héroe.

        🔧 Corrección medida. Aquí decía que el <h1> es lo que Chrome elige como
        LCP en la portada. **Es falso.** Lighthouse lo midió y el elemento LCP es
        `img.hero__fondo`, la fotografía, con 412×730 px de área. El texto no
        compite: la foto lo tapa por tamaño. Por eso el héroe precarga su propia
        imagen desde `Hero.astro`. */}
    <link
      rel="preload"
      href="/fuentes/gilda-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* is:inline — no es un script de cliente: es metadato que debe quedar
        literal en el HTML. Sin la directiva, Astro intenta procesarlo. */}
    {indexable && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <Analitica />
  </head>
  <body>
    <a class="sr-only saltar" href={ancla(idioma, 'contenido')}>{t('nav.saltar')}</a>
    <Header idioma={idioma} rutaActual={rutaActual} sobreHero={sobreHero} />
    <main id={idAncla(idioma, 'contenido')}>
      <slot />
    </main>
    <Footer idioma={idioma} />
    <BotonWhatsApp idioma={idioma} titulo={titulo} />
  </body>
</html>
