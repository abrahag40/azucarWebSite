---
/**
 * Restaurante (bloqueado por C0 — ver `src/data/restaurante.ts`).
 *
 * La ruta comprueba `carta.publicable`: si es `false`, la pagina no se genera
 * y el sitio da 404. Hoy esta en `true` —C0 resuelta— aunque la carta siga
 * vacia: el restaurante existe y merece su pagina; lo que falta es el menu,
 * y esa ausencia se comunica en vez de dejar la seccion en blanco (L-082).
 */
import Base from '../layouts/Base.astro';
import BannerPagina from '../components/BannerPagina.astro';
import MenuRestaurante from '../components/MenuRestaurante.astro';
import { carta } from '../data/restaurante';
import { usarT, type Idioma } from '../i18n/ui';
import { Image } from 'astro:assets';
import banner from '../assets/galeria/01-roof-top-atardecer.webp';
import fotoCocina from '../assets/galeria/06-alberca-roof-top.webp';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);
---
<Base
  idioma={idioma}
  rutaActual="restaurante"
  titulo={`${t('restaurante.titulo')} | Azucar Hotel Tulum`}
  descripcion={t('restaurante.meta')}
>
  {/* El nombre del local manda en el titular, y la categoría queda de
      antetítulo: «Tenedor» es lo que el huésped tiene que recordar, no la
      palabra «restaurante». Si `nombre` volviera a ser `null` —el estado en el
      que estuvo mientras no supimos cómo se llamaba— el titular cae de vuelta
      en «Restaurante» y la página sigue funcionando. */}
  <BannerPagina
    imagen={banner}
    antetitulo={carta.nombre ? t('nav.restaurante') : undefined}
    titulo={carta.nombre ? carta.nombre[idioma] : t('restaurante.titulo')}
  />
  <section class="seccion" aria-labelledby="cocina-titulo">
    <div class="contenedor">
      <p class="entrada-pagina">{t('restaurante.entrada')}</p>
      {/* 🔴 DOS COLUMNAS, y no por rellenar. El texto tenía la medida de lectura
          —42 rem— dentro de un contenedor de 75, así que a partir de un
          portátil normal la mitad derecha de la pantalla quedaba en blanco. La
          salida fácil habría sido ensanchar el párrafo; sería peor, porque una
          línea de 120 caracteres se lee mal.

          Así que el ancho sobrante se llena con CONTENIDO: la fotografía del
          roof top —que es dónde se come, y eso el texto lo dice pero no lo
          enseña— y las dos condiciones prácticas, que estaban perdidas al final
          del párrafo y son lo que alguien busca antes de venir a cenar.

          En móvil se apila y las notas van DESPUÉS del texto: primero se
          entiende qué cocina es, después se mira el horario. */}
      <div class="cocina">
        <div class="cocina__texto">
          <h2 id="cocina-titulo" class="cocina__titulo">{t('restaurante.cocinaTitulo')}</h2>
          <p class="cocina__parrafo">{t('restaurante.cocinaP1')}</p>
          <p class="cocina__parrafo">{t('restaurante.cocinaP2')}</p>
          <p class="cocina__parrafo">{t('restaurante.cocinaP3')}</p>
        </div>
        <aside class="cocina__lado">
          <Image
            class="cocina__foto"
            src={fotoCocina}
            alt=""
            widths={[420, 700]}
            sizes="(min-width: 60rem) 24rem, 92vw"
            loading="lazy"
            quality={50}
          />
          <p class="cocina__nota">{t('restaurante.horario')}</p>
          <p class="cocina__nota">{t('restaurante.alergias')}</p>
        </aside>
      </div>
    </div>
  </section>
  <MenuRestaurante idioma={idioma} />

</Base>

<style>
  .cocina {
    margin-top: var(--space-7);
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .cocina__texto { max-width: var(--container-text); }
  .cocina__foto {
    width: 100%; height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-5);
  }
  /* Dos columnas desde 60rem, que es donde el texto deja de crecer y empieza a
     sobrar ancho. La derecha se queda en 24rem: más y compite con el texto. */
  @media (min-width: 60rem) {
    .cocina { grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--space-8); }
  }
  .cocina__titulo { font-size: var(--text-2xl); margin-bottom: var(--space-5); }
  .cocina__parrafo {
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    margin-bottom: var(--space-4);
  }
  /* Las dos notas prácticas se separan del cuerpo: son condiciones, no relato.
     Mismo criterio que `DatosPracticos` en la ficha de alojamiento. */
  .cocina__nota {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.6;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-top: var(--space-4);
  }
</style>
