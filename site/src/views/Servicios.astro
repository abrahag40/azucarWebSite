---
import Base from '../layouts/Base.astro';
import BannerPagina from '../components/BannerPagina.astro';
import SeccionAmenidades from '../components/SeccionAmenidades.astro';
import SeccionInstalaciones from '../components/SeccionInstalaciones.astro';
import { usarT, type Idioma } from '../i18n/ui';
import banner from '../assets/hero-roof-top.webp';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);
---
<Base
  idioma={idioma}
  rutaActual="servicios"
  titulo={`${t('nav.amenidades')} | Azucar Hotel Tulum`}
  descripcion={t('servicios.meta')}
>
  <BannerPagina imagen={banner} titulo={t('nav.amenidades')} />
  {/* Variante EDITORIAL: mismo contenido que la portada, otra composición.
      El porqué está en la cabecera de `SeccionAmenidades.astro`. */}
  <SeccionAmenidades idioma={idioma} variante="editorial" />
  <SeccionInstalaciones idioma={idioma} />
</Base>
