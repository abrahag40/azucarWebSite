---
/**
 * Solicitud de reserva (H3.1, H3.2).
 *
 * La página sólo hace tres cosas: presenta el proceso, pasa los tipos publicados
 * al módulo `booking/` y publica los datos de contacto directos. Toda la lógica
 * vive detrás de la frontera del módulo — ver `src/booking/README.md`.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BannerPagina from '../components/BannerPagina.astro';
import banner from '../assets/galeria/05-camastros-palapa.webp';
import FormularioSolicitud from '../booking/FormularioSolicitud.astro';
import { contacto } from '../data/hotel';
import { usarT, ruta, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);

// Mismo orden que el listado: el huésped reconoce la lista que acaba de ver.
const tipos = (await getCollection('alojamiento', (x) => x.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);
---
<Base
  idioma={idioma}
  rutaActual="reservar"
  titulo={`${t('reserva.cta')} | Azucar Hotel Tulum`}
  descripcion={t('reserva.pagMeta')}
>
  <BannerPagina imagen={banner} titulo={t('reserva.cta')} />

  <section class="seccion seccion--entrada">
    <div class="contenedor"><p class="entrada entrada-pagina">{t('reserva.entrada')}</p></div>
  </section>

  <div class="seccion">
    <div class="contenedor solicitud__disposicion">
      <div class="solicitud__formulario">
        <FormularioSolicitud tipos={tipos} idioma={idioma} />
      </div>

      <aside class="solicitud__lado">
        {/* La franja de RESERVA DIRECTA sustituye a los tres pasos de «Cómo
            funciona» (cliente, 2026-09-03).

            Las mayúsculas son de `text-transform`, y el énfasis de <strong>:
            el texto real del diccionario está en minúsculas. Escribirlo en
            mayúsculas dentro del dato haría que VoiceOver y NVDA lo
            deletrearan letra por letra —«ere-e-ese-e-erre-uve-a»—, que es el
            defecto que más se ve en las promociones de hotel. Así el ojo lee
            mayúsculas y el oído lee palabras.

            🔴 NO dice qué promociones son, ni cuánto descuentan, porque C3
            sigue sin responder y una cifra sin impuestos reproduce la queja
            que este proyecto vino a curar (regla 3). */}
        <section class="promo" aria-labelledby="promo-titulo">
          <p class="promo__texto" id="promo-titulo">
            {t('reserva.promoAntes')} <strong>{t('reserva.promoFuerte1')}</strong>
            {' '}{t('reserva.promoEnMedio')}{' '}
            <strong>{t('reserva.promoFuerte2')}</strong>
          </p>
        </section>

        {/* Regla 2: nunca se muestra disponibilidad que no podamos respaldar.
            Y en vez de callarlo, se explica: un hotel sin calendario en línea
            levanta la sospecha de estar improvisando, y decir el motivo la
            desactiva. Sale de la tarjeta que se retiró, pero NO del sitio. */}
        <section class="tarjeta">
          <p class="tarjeta__nota">{t('reserva.porQueNoHayCalendario')}</p>
        </section>

        {/* Siempre visible, no sólo en <noscript>: si el `mailto` no abre nada
            —correo web sin protocolo registrado— ésta es la salida.
            Sin titular ni texto de relleno desde el 2026-09-03: son los datos
            y nada más. El título sigue existiendo para `aria-labelledby`
            —una región sin nombre no se localiza con lector de pantalla— pero
            va en `.sr-only`, no pintado. */}
        <section class="tarjeta" aria-labelledby="directo">
          <h2 class="sr-only" id="directo">{t('reserva.directo')}</h2>
          <ul class="contactos">
            <li><a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></li>
            {contacto.telefonos.map((tel) => (
              <li><a class="telefono" href={`tel:${tel.replace(/[^+\d]/g, '')}`}>{tel}</a></li>
            ))}
          </ul>
          <p class="tarjeta__nota">
            <a href={ruta(idioma, 'aviso-de-privacidad')}>{t('footer.privacidad')}</a>
          </p>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .seccion--entrada { padding-bottom: 0; }
  .entrada { margin: 0; }   /* el tamaño lo pone `.entrada-pagina` en base.css */
  .solicitud__disposicion { display: grid; gap: var(--space-7); }
  @media (min-width: 60rem) {
    /* El formulario primero y ancho; la ayuda al lado. En móvil el orden del
       marcado ya es el correcto —formulario, luego contexto— así que no hace
       falta reordenar y no se usa `order`, que separaría el orden visual del
       orden de tabulación. */
    .solicitud__disposicion {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .solicitud__lado { display: grid; gap: var(--space-5); min-width: 0; }
  .tarjeta {
    background: var(--color-surface-warm);
    padding: var(--space-5);
    border-radius: var(--radius-sm);
  }
  .tarjeta__titulo { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .tarjeta__nota {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-body);
    margin-bottom: 0;
  }
  /* ── Franja de reserva directa ────────────────────────────────────────
     Llama la atención con TRES recursos distintos y ninguno de ellos es un
     color nuevo: fondo verde de botón, un brillo que la recorre una vez al
     entrar en pantalla, y un latido muy leve del borde.

     Contraste: texto blanco sobre `--color-boton` (#376452) da 6.76:1, por
     encima del 4.5:1 de WCAG 1.4.3. El brillo es blanco al 18 %: por encima
     no cambia el color efectivo del texto lo bastante como para bajar de
     4.5:1 —medido en el punto más claro del barrido—. */
  .promo {
    position: relative;
    overflow: hidden;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-boton);
    color: #fff;
    text-align: center;
    /* Latido del borde: dos segundos y medio, tres veces, y para. Una
       animación que no termina nunca es ruido a los diez segundos, y en una
       página de formulario compite con el campo que se está rellenando. */
    animation: promo-latido 2.4s var(--ease) 0.4s 3;
  }
  .promo__texto {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: var(--leading-snug);
    /* Sobre el pseudo-elemento del brillo, que va detrás. */
    position: relative;
    z-index: 1;
  }
  /* `strong` no cambia de color —sería un segundo contraste que medir— sino
     de peso. Dos pesos distintos del mismo blanco se distinguen a la primera
     y no dependen de que el usuario vea el color. */
  .promo__texto strong { font-weight: 600; }

  /* El brillo. Una banda diagonal que cruza la franja de izquierda a derecha.
     `will-change` NO se declara: sólo se anima `transform`, que ya va en el
     compositor, y declararlo mantendría una capa viva durante toda la vida de
     la página para una animación que dura tres segundos. */
  .promo::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 -60%;
    width: 55%;
    background: linear-gradient(
      100deg,
      rgb(255 255 255 / 0) 0%,
      rgb(255 255 255 / 0.18) 50%,
      rgb(255 255 255 / 0) 100%
    );
    transform: translateX(0);
    animation: promo-brillo 4.5s var(--ease) 0.6s 3;
  }
  @keyframes promo-brillo {
    0%   { transform: translateX(0); }
    45%  { transform: translateX(320%); }
    100% { transform: translateX(320%); }
  }

  @keyframes promo-latido {
    0%, 100% { box-shadow: 0 0 0 0 rgb(55 100 82 / 0); }
    35%      { box-shadow: 0 0 0 6px rgb(55 100 82 / 0.28); }
    70%      { box-shadow: 0 0 0 0 rgb(55 100 82 / 0); }
  }

  /* 🔴 WCAG 2.3.3 y 2.2.2. Quien pide menos movimiento no ve NINGUNA de las
     dos: la franja se queda quieta, con su color y su contraste intactos.
     El mensaje no depende de la animación — la animación sólo lo señala. */
  @media (prefers-reduced-motion: reduce) {
    .promo,
    .promo::after { animation: none; }
    .promo::after { display: none; }
  }
  .contactos { list-style: none; padding: 0; margin: 0 0 var(--space-4); display: grid; gap: var(--space-2); }
  /* 44 px de alto: los enlaces en línea no suman su relleno vertical a la caja,
     y este defecto ya salió TRES veces en este proyecto (pie, selector de idioma
     y el enlace al aviso de aquí abajo). `display: block` mas altura mínima lo
     cierra (WCAG 2.5.8). */
  .contactos a,
  .tarjeta__nota a { display: inline-block; min-height: 44px; line-height: 44px; }
</style>
