---
/**
 * Qué hacer en Tulum.
 *
 * Apartado suelto en el menú, por decisión del cliente (2026-09-01), y no
 * colgado de «Amenidades»: lo de aquí NO es del hotel. Las amenidades son lo
 * que el hotel ofrece y responde por ello; esto es el entorno, sobre el que no
 * responde nadie. Mezclarlos habría sugerido que el hotel organiza —y por tanto
 * garantiza— salidas que no organiza.
 *
 * El contenido y sus dos reglas duras —sólo lugares públicos, ninguna
 * distancia— están en `src/data/actividades.ts`.
 */
import Base from '../layouts/Base.astro';
import BannerPagina from '../components/BannerPagina.astro';
import RejillaActividades from '../components/RejillaActividades.astro';
import CreditosFotos from '../components/CreditosFotos.astro';
import FranjaLlamada from '../components/FranjaLlamada.astro';
import { usarT, type Idioma } from '../i18n/ui';
import banner from '../assets/galeria/04-vista-selva-mar.webp';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);
---
<Base
  idioma={idioma}
  rutaActual="actividades"
  titulo={`${t('actividades.titulo')} | Azucar Hotel Tulum`}
  descripcion={t('actividades.meta')}
>
  {/* La foto del banner es del hotel y muestra la selva y el mar desde el roof
      top: ilustra el ENTORNO sin fingir ser ninguno de los ocho lugares. */}
  <BannerPagina imagen={banner} titulo={t('actividades.titulo')} />

  <section class="seccion">
    <div class="contenedor">
      {/* La entradilla llevaba `class="entradilla"` — una clase que NO EXISTE
          en ninguna hoja del sitio. El párrafo salía sin un solo estilo en
          ésta y en otras tres páginas, y así lo vio el cliente: «el texto de
          inicio se ve demasiado simple». La clase buena es `entrada-pagina`.
          `verificar-estilos.mjs` lo venía avisando sin romper nada; desde hoy
          rompe. */}
      <p class="entrada-pagina entrada-pagina--destacada">{t('actividades.entrada')}</p>
      <div class="rejilla">
        <RejillaActividades idioma={idioma} />
      </div>
      <p class="cierre">{t('actividades.cierre')}</p>
    </div>
  </section>

  <CreditosFotos idioma={idioma} />
  <FranjaLlamada idioma={idioma} />
</Base>

<style>
  /* La entradilla de ESTA página pesa más que en las demás: es la que hace el
     trabajo de encuadre —«el mar es sólo una de las ocho razones»— y de ella
     depende que se lean las ocho tarjetas. Sube a `--text-lg`, se le da la
     medida de lectura y se le pone la regla de acento que el sitio usa para
     marcar lo que hay que leer (misma que `.cocina__nota` y `.bloque`).
     No se centra: un párrafo de dos líneas centrado sobre una rejilla alineada
     a la izquierda deja dos ejes distintos compitiendo. */
  .entrada-pagina--destacada {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-ink);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-5);
    max-width: 46rem;
  }
  .rejilla { margin-top: var(--space-8); }
  .cierre {
    margin-top: var(--space-8);
    max-width: var(--container-text);
    color: var(--color-ink);
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
    font-family: var(--font-ui);
    letter-spacing: var(--tracking-wide);
  }
</style>
