---
import { usarT, type Idioma } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SeccionPresentacion from '../components/SeccionPresentacion.astro';
import SeccionAlojamiento from '../components/SeccionAlojamiento.astro';
import FranjaImagen from '../components/FranjaImagen.astro';
import SeccionAmenidades from '../components/SeccionAmenidades.astro';
import SeccionGaleria from '../components/SeccionGaleria.astro';
import SeccionPreguntas from '../components/SeccionPreguntas.astro';
import SeccionExperiencias from '../components/SeccionExperiencias.astro';
import FranjaLlamada from '../components/FranjaLlamada.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = usarT(idioma);
---
{/* 🔴 SIN `sobreHero` desde el 2026-09-07 — y su ausencia es el cambio.
    El cliente pidió que el vídeo dejara de ser a sangre y que arriba, «a la
    altura del menú», hubiera una banda del color de la sección siguiente.
    Esa banda no hay que construirla: **es la cabecera normal del sitio**, la
    que ya usan las otras 24 páginas —blanca al 94 %, sticky, con el texto en
    tinta y sus contrastes medidos desde el sprint 1—.

    Y no era opcional hacerlo así. Con `sobreHero` el menú va en BLANCO, pensado
    para leerse sobre la fotografía; puesto sobre una banda blanca habría
    quedado invisible. La petición del cliente y el cambio de cabecera son la
    misma decisión, no dos.

    Consecuencia deliberada: en la portada el menú pasa a acompañar el scroll,
    como en el resto del sitio, en vez de irse con el héroe. */}
<Base
  idioma={idioma}
  titulo={t('home.titulo')}
  descripcion={t('home.meta')}
>
  {/* ── ORDEN DE LA PORTADA ──────────────────────────────────────────────
      Reproduce el recorrido de `index11.html` de Cappa, sustituyendo cada
      sección por la nuestra equivalente:

        Cappa                        aquí
        ─────────────────────────    ────────────────────────────────────────
        slider                    →  Hero
        about                     →  SeccionPresentacion
        rooms1                    →  SeccionAlojamiento
        pricing (bg-blck)         →  FranjaLlamada  · sin tarifas, ver C3
        video-wrapper             →  FranjaImagen   · el hotel no tiene vídeo
        facilties                 →  SeccionAmenidades
        services                  →  SeccionExperiencias
        (gallery.html)            →  SeccionGaleria
        testimonials              →  SeccionPreguntas · ver H4.10
        (contact.html)            →  SeccionContacto
        news / clients            →  no existen: sin blog y sin marcas asociadas

      Los fondos alternan blanco · cálido · oscuro · foto, que es el pulso
      visual de la plantilla y la razón de que el recorrido no se haga plano. */}
  <Hero idioma={idioma} />
  <SeccionPresentacion idioma={idioma} />
  {/* Seis de los ocho tipos, no tres. Cappa muestra cinco en su carrusel de
      `rooms1`; con tres, la sección se leía como una muestra y no como un
      catálogo. Los ocho harían la portada más larga que la página de listado. */}
  <SeccionAlojamiento idioma={idioma} limite={6} />
  <FranjaLlamada idioma={idioma} />
  <FranjaImagen idioma={idioma} />
  <SeccionAmenidades idioma={idioma} />
  <SeccionExperiencias idioma={idioma} />
  <SeccionGaleria idioma={idioma} />
  <SeccionPreguntas idioma={idioma} />
  <SeccionContacto idioma={idioma} />
</Base>
